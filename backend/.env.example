# ScholarZone Environment Configuration
# Copy this file to .env and fill in your values

# Application environment (development, production)
SCHOLARZONE_ENVIRONMENT=development

# Database URL
# SQLite (default): sqlite:///backend/scholarzone.db
# PostgreSQL: postgresql+psycopg://username:password@host:5432/scholarzone
# SCHOLARZONE_DATABASE_URL=postgresql+psycopg://username:password@host:5432/scholarzone

# CORS allowed origins (comma-separated)
SCHOLARZONE_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Verification trigger secret (generate a strong random string for production)
# This secret is required for the /internal/verify/trigger endpoint
# Generate with: openssl rand -hex 32
# SCHOLARZONE_VERIFICATION_SECRET=your-secret-here

# Admin review secret (generate a strong random string for production)
# This secret is required for the /admin/images/* endpoints
# Generate with: openssl rand -hex 32
# SCHOLARZONE_ADMIN_SECRET=your-admin-secret-here

# Resend API key for email notifications
# RESEND_API_KEY=your-resend-api-key

# Notification email for verification reminders
# NOTIFICATION_EMAIL=your-email@example.com
