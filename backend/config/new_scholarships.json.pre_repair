    {
      "name": "EAC Scholarship Programme (EACSP) - Two-Year Funded Master's Scholarships, Cohort 4 (Phase II)",
      "country": "Multiple countries",
      "region": "Africa",
      "degree_levels": "Master's",
      "funding_type": "Fully Funded",
      "program_type": "Regional scholarship",
      "official_source": "Inter-University Council for East Africa (IUCEA), implementing the East African Community and Federal Republic of Germany initiative",
      "official_source_url": "https://iucea.org/two-year-funded-masters-scholarships-for-cohort-4/",
      "catalogue_url": "https://iucea.org/publications/scholarships/",
      "official_updates_url": "https://iucea.org/call-for-applications/",
      "status": "upcoming",
      "is_verified": true,
      "last_verified_date": "2026-10-04",
      "deadline": "10 September 2026, 17:00 East Africa Time (Cohort 4 application period: 20 August to 10 September 2026)",
      "deadline_date": null,
      "deadline_precision": "recurring",
      "application_period": "Cohort 4 ran 20 August to 10 September 2026 and is closed. Phase II of the programme is stated to cover three cohorts from 2025, so a further cohort is expected on the same annual cycle; no next-cohort window was published as of 2026-10-04.",
      "duration": "2 years of Master's study",
      "description": "The EAC Scholarship Programme is a regional initiative of the East African Community and the Federal Republic of Germany, implemented by the Inter-University Council for East Africa. It funds academically talented but financially disadvantaged students from the eight EAC Partner States to pursue two-year Master's degrees at a participating university in a different EAC Partner State. Awards are restricted to six thematic areas - mathematics, engineering, informatics, science, technology and business science - and Cohort 4 offered up to 120 scholarships across 60 approved Master's programmes at partner universities in Kenya, Rwanda, Uganda and Tanzania. The scholarship package covers a return economy air ticket, full tuition paid directly to the host university, a EUR 200 arrival allowance, a monthly stipend of EUR 380, a EUR 650 lump sum for study materials, a one-time EUR 1,500 study and research allowance, medical insurance, and entry visa or student pass fees where required.",
      "eligibility_summary": "Citizens of any of the eight EAC Partner States, aged below 35 at the time of application, holding a Bachelor's degree at Second Class Upper Division, Distinction or equivalent, and applying to an eligible Master's programme at a participating university in an EAC Partner State other than their country of citizenship. Applicants must complete the separate online scholarship application in addition to a university admission application.",
      "eligibility": [
        "Be a citizen of any of the eight EAC Partner States (Burundi, Democratic Republic of Congo, Kenya, Rwanda, Somalia, South Sudan, United Republic of Tanzania, Uganda)",
        "Be below 35 years of age at the time of application",
        "Apply to study in an EAC Partner State other than their country of citizenship",
        "Possess a Bachelor's degree with a minimum of Second Class Upper Division, Distinction or equivalent qualification",
        "Have applied for admission to an eligible Master's programme offered by a partner university",
        "Submit a complete scholarship application within the stipulated application period"
      ],
      "coverage": [
        "One return economy-class air ticket between the scholar's home country and the host country",
        "Full tuition fees payable directly to the host university",
        "EUR 200 arrival allowance",
        "Monthly stipend of EUR 380",
        "EUR 650 lump-sum allowance for study materials",
        "One-time EUR 1,500 study and research allowance",
        "Medical insurance for the duration of the scholarship",
        "Visa or entry fee where payment of an entry pass or student pass is required",
        "Participation in at least one extracurricular event"
      ],
      "benefits": [
        "Full tuition fees paid directly to the host university",
        "Return economy-class air ticket",
        "Monthly stipend of EUR 380 for accommodation, meals, local transport and other living expenses",
        "Arrival allowance of EUR 200",
        "EUR 650 for study materials",
        "One-time EUR 1,500 study and research allowance",
        "Medical insurance for the whole scholarship period",
        "Visa or entry pass fee where required",
        "Leadership development, mentoring, networking and regional integration activities",
        "Scholarship opportunity cannot be deferred or transferred to another person"
      ],
      "requirements": [
        "Apply for admission to a partner university in an EAC Partner State other than your country of citizenship, indicating your intention to apply for the EAC Scholarship Programme and paying the university application fee where applicable",
        "Complete the separate online EAC Scholarship Application form",
        "Submit all supporting documents in a single zipped PDF folder, with files named using the prescribed document codes",
        "Email the zipped folder to eacsp@iucea.org and scholarships@adroitconsultinternational.com with the prescribed subject line format",
        "Submit the application in English",
        "Ensure foreign academic qualifications are equated by the host country's national higher-education council or other competent authority before admission",
        "Have non-English transcripts and certificates translated into English by an accredited provider, submitting both originals and copies"
      ],
      "required_documents": [
        "E01 National ID or passport (mandatory)",
        "E02 Passport photograph in colour of full head and upper shoulders",
        "E03 Proof of university admission application (admission letter, acknowledgement email, receipt or portal screenshot)",
        "E04 Certified true copies of Bachelor's degree certificate and academic transcript",
        "E05 Curriculum vitae",
        "E06 Bank statements for the last six months, where applicable",
        "E07 Academic reference letter",
        "E08 Professional reference letter",
        "E24 English language proficiency certificate such as IELTS or TOEFL, where applicable",
        "Financial-need evidence such as E09 recent payslip, E22 tuition arrears or fee balance statements, and E23 university correspondence demonstrating financial hardship"
      ],
      "application_method": [
        "Review the call and select a programme and university from the published list of 60 eligible Master's programmes",
        "Apply for admission to that university, declaring your intention to apply for the EAC Scholarship Programme and paying any application fee",
        "Complete the online EAC Scholarship Application form, which opened on 20 August 2026",
