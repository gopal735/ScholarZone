      "is_verified": true,
      "last_verified_date": "2026-10-04",
      "duration": "Maximum funding period three years and six months, with additional extension options in cases of illness, maternity protection periods and child-rearing.",
      "deadline": "Sunday, 1 November 2026 (registration deadline for Verfahren I-2027, selection decision March 2027)",
      "deadline_date": "2026-11-01",
      "deadline_precision": "exact",
      "application_period": "Two annual selection rounds for external applicants: Verfahren I-2027 (Anmeldeschluss 1 November 2026, decision March 2027) and Verfahren II-2027 (Anmeldeschluss 1 June 2027, decision October 2027).",
      "eligibility_summary": "Outstanding academic performance, interdisciplinary interest, social responsibility and voluntary engagement, membership in the Catholic Church with a lived Christian faith, university entrance qualification, and admission to doctoral study at a recognised university.",
      "eligibility": [
        "Outstanding academic performance and interdisciplinary interest ('herausragende fachliche Leistungen und interdisziplinäres Interesse')",
