    {
      "name": "TWAS-CSIR Postgraduate Fellowship Programme",
      "legacy_titles": [
        "TWAS-CSIR Postgraduate Fellowship Programme"
      ],
      "country": "India",
      "degree_levels": "PhD",
      "funding_type": "Fully Funded",
      "official_source": "UNESCO-TWAS and Council of Scientific & Industrial Research (CSIR), India",
      "official_source_url": "https://twas.org/opportunity/twas-csir-postgraduate-fellowship-programme",
      "status": "upcoming",
      "is_verified": true,
      "last_verified_date": "2026-10-04",
      "region": "Asia and Pacific",
      "duration": "Full-time fellowships up to a maximum of 4 years; sandwich fellowships from a minimum of 6 months up to a maximum decided by the host institute but no greater than 3 years",
      "deadline": "Official wording for the 2026 call: \"Closing date of this fellowship: 6 then 20 May 2026 now extended until 3 June 2026\". The call is closed and results are expected at the end of 2026 or early 2027, with fellows starting no earlier than 2027.",
      "deadline_date": null,
      "deadline_precision": "recurring",
      "application_period": "Annual. The 2026 call opened 6 March 2026 and closed 20 May 2026, extended to 3 June 2026. Applications can only be submitted through the TWAS online portal once the call is open.",
      "eligibility_summary": "Nationals of a developing country other than India, aged 35 or under on 31 December of the application year, holding a Master's degree in science and technology, regularly employed with a research assignment in their home country, accepted at a CSIR laboratory or institution with an official acceptance letter, and not holding a visa for temporary or permanent residency in India or any developed country.",
      "eligibility": [
        "Maximum age of 35 years on 31 December of the application year",
        "National of a developing country, other than India",
        "Must not hold any visa for temporary or permanent residency in India or any developed country",
        "Must hold a Master's degree in science and technology",
        "Must be regularly employed in their home country and hold a research assignment there",
        "Sandwich fellowships: must be a registered PhD student in the home country and provide the Registration and No Objection Certificate from the home university",
        "Full-time fellowships: must be willing to register at a university in India within the first year if agreed by CSIR",
        "Must be accepted at a CSIR laboratory or institution and provide an official acceptance letter from the host institution",
        "Must provide evidence of English proficiency if the medium of education was not English",
        "Must provide evidence that they will return to their home country on completion of the fellowship",
        "Must not take up other assignments during the fellowship period",
        "Must be financially responsible for any accompanying family members"
      ],
      "coverage": [
        "Monthly stipend from CSIR to cover living costs, food and health insurance",
        "Subsidized accommodation",
        "Full-time fellowship tenable for up to 4 years in a CSIR laboratory or institute"
