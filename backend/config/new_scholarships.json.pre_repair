            "Housing costs above the 992 Euro monthly support",
            "Books, travel between home country and Germany, and other personal expenses"
          ],
          "document_audit": [
            "Online application form for the study scholarship (Bewerbung um ein Stipendium fÃ¼r das Studium)",
            "Graded transcripts up to date",
            "Expert opinion (Gutachten) uploaded through the online portal",
            "All supporting documents uploaded via the FES portal - an incomplete application breaks the process"
          ],
          "alerts": [
            {
              "trigger": "By 30 November",
              "message": "Deadline for Master's programmes starting in the winter semester."
            },
