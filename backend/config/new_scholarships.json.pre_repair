    {
      "name": "Hungarian Diaspora Scholarship Programme",
      "legacy_titles": [
        "Hungarian Diaspora Scholarship Programme"
      ],
      "country": "Hungary",
      "degree_levels": "Bachelor's, Master's, One-tier Master's, Doctoral, Non-degree",
      "funding_type": "Fully Funded",
      "official_source": "Hungarian Government / Tempus Public Foundation",
      "official_source_url": "https://diasporascholarship.hu/en",
      "status": "upcoming",
      "is_verified": true,
      "last_verified_date": "2026-10-04",
      "region": "Europe",
      "description": "The Hungarian Diaspora Scholarship Programme, authorised by Government Decree 203/2020 and implemented by Tempus Public Foundation, funds Hungarian citizens and people of Hungarian origin living in the diaspora to study in Hungary. Applicants must live in a diaspora region as a foreign citizen with a foreign address of residence and must be recommended by a Hungarian diplomatic mission or by a Hungarian diaspora organisation in their country. The 2026/2027 call covered 33 Hungarian higher education institutions with nearly 1300 study programmes, and applications were submitted in the DreamApply system by 2 February 2026, 2 p.m. CET. Selection runs through five points from a technical check in February to a Diaspora Scholarship Committee session in May 2026.",
      "deadline": "The deadline for submitting the complete application: 02 February 2026 - 14:00 (2 p.m., Central European Time).",
      "deadline_date": "2026-02-02",
      "deadline_precision": "exact",
      "application_period": "One application round per year. For 2026/2027: preparation in November 2025, deadline for submitting applications 2 February 2026; technical check February 2026; validation of recommendations 28 February 2026; institutional admissions March-May 2026; evaluation of motivation letters April 2026; Diaspora Scholarship Committee session May 2026; selection results notified June 2026; visa process July-August 2026; arrival in Hungary September 2026.",
      "eligibility_summary": "Applicants must have Hungarian roots evidenced in a diaspora motivation letter, live in the diaspora region as a foreign citizen with a foreign address of residence, and hold a recommendation from the Hungarian diplomatic mission accredited to that country or from a Hungarian diaspora organisation there. Applicants must also agree to support the local Hungarian diaspora with community work after obtaining their diploma, and must not previously have held the Diaspora Scholarship or another Hungarian Government scholarship at the same or a higher level.",
      "eligibility": [
        "Has Hungarian roots, evidenced by a diaspora motivation letter written in Hungarian or English",
        "Lives in the diaspora region and is a foreign citizen with a foreign address of residence",
        "Recommended by the Hungarian diplomatic mission accredited to that country (including honorary consuls) or by a Hungarian diaspora organisation operating there",
        "Agrees to support the local Hungarian diaspora with community work after obtaining the diploma, for the period specified in the call for applications",
        "Has not previously participated in the Hungarian Diaspora Scholarship at the same or a higher level, or in other Hungarian Government scholarship programmes",
        "Applicants holding dual citizenship are eligible, including where one citizenship is Hungarian, by applying with the other citizenship",
        "Applicants under 18 may apply if they turn 18 by 31 December of the year of the award (16 for Dance), with a declaration of their legal representative"
      ],
      "coverage": [
        "Full tuition fee coverage for the chosen Hungarian study programme",
        "Monthly stipend for scholarship holders",
        "Accommodation support"
      ],
      "benefits": [
        "Fully funded study in Hungary at 33 higher education institutions",
        "Access to nearly 1300 study programmes, mostly in English and Hungarian",
        "One-year Hungarian language preparatory course available within the programme",
        "Optional Summer University Courses with the Hungarian Diaspora Scholarship"
      ],
      "required_documents": [
        "Statement for application",
        "Declaration of legal representative (applicants under 18)",
        "Diaspora Recommendation Letter from a Hungarian diplomatic mission or Hungarian diaspora organisation, using the official template",
        "Motivation letter addressed to the Hungarian Diaspora Scholarship Programme, plus one addressed to each chosen institution",
        "Secondary school certificate proving completion of secondary studies outside Hungary",
        "Academic transcript of records",
        "Language certificates as required by the chosen host university",
        "Mandatory medical certificate on the official template, for awardees without EU/EEA citizenship, presented on arrival and not uploaded"
      ],
      "catalogue_url": "https://apply.diasporascholarship.hu/",
      "official_updates_url": "https://diasporascholarship.hu/en/news/",
      "english_requirement": null,
      "requirements": [
        "Obtain the Diaspora Recommendation Letter from a Hungarian diplomatic mission or Hungarian diaspora organisation; a private individual cannot provide it",
        "Register and submit in the DreamApply system at apply.diasporascholarship.hu by the deadline",
