          ],
          "eligibility": [
            "Resident citizen of an African Union member state or African Commonwealth country",
            "Under 26 on 1 January of the intake year for undergraduate programmes, over 18",
            "Under 40 on 1 January of the intake year for MPhil, MPhil/PhD and PhD programmes",
            "Offered or applied for a place at a listed public Mauritian institution",
            "About 60% or 12/20 equivalent average, or A-level equivalent",
