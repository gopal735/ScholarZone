          "english_requirement": "TOEFL 90 points, IELTS Academic band 6.5, Duolingo English Test 120 points, or Cambridge Proficiency/Advanced 176 minimum (B2–C2). Not required for native English speakers or those who completed an undergraduate degree at an English-speaking university.",
          "english_requirement_note": "Published on the official admissions page as 'Proof of your level in English: 90 TOEFL points; 6.5 IELTS band; 120 Duolingo English points; and Cambridge Exams (Proficiency or Advanced, 176 minimum score)'.",
          "selection_criteria": [
            "Outstanding academic record",
            "Strong quantitative background",
            "Reference letters",
            "Quality of the statement of purpose, including a thorough explanation of recent mathematical background",
            "High GPA"
          ],
          "selection_weighting": null,
          "duration": "One Master's programme cycle. Tuition fees published for 2027-28 are €18,500 (all other programmes) and €20,000 (Data Science programmes).",
          "award_holder_conditions": [
            "Financial aid is awarded on academic merit only: 'Only applicants with outstanding academic records will receive a financial offer'",
            "Applicants after 15 January are considered only for remaining available funding",
            "The application fee is non-refundable",
            "The application is not considered complete until both reference letters have been uploaded",
            "Fulfilling the application requirements does not guarantee admission"
          ],
          "supplements_or_initiatives": [
            "Ramón Areces Foundation Scholarships",
            "Unicredit Foundation Masterscholarships",
            "Aena tuition waivers",
            "Sabadell tuition waivers",
            "Repsol Fundación tuition waivers"
          ],
          "official_contacts": {
            "general": "BSE Admissions Office",
            "email": "admissions@bse.eu",
            "phone": "+34 93 542 1234"
          },
          "description": "The Barcelona School of Economics offers merit-based tuition funding to the most talented candidates in its Master's programmes. Awards take the form of tuition-fee waivers of 25%, 50%, 75% or 100%, plus a limited number of fully-funded scholarships that cover 100% of fees and may add a stipend. Named sponsor scholarships from the Ramón Areces Foundation and the Unicredit Foundation cover 100% of tuition for the Economics and Finance Programs, and Aena, Sabadell and Repsol Fundación provide further full or partial waivers for all Master's programmes. BSE awards an average of €550,000 in merit-based funding each year, with around 24% of matriculated students fully or partially funded; funding is prioritised for applicants who submit a completed application before 15 January.",
          "program_type": "Merit-based tuition-fee waivers and named full scholarships for Master's students",
          "region": "Europe",
          "coverage": "Tuition fees only; published 2027-28 tuition is €18,500 (most programmes) and €20,000 (Data Science programmes), and fees do not cover housing or living expenses",
          "last_verified_date": "2026-10-04"
        },
        "applicant_utility": {
          "application_readiness_checklist": [
            "Apply before 15 January if you want to be considered for all funding opportunities, not just what remains",
            "Check whether your target programme is in the Economics or Finance Program if you are aiming at the Ramón Areces or Unicredit full scholarships",
            "Have your English test ready: TOEFL 90, IELTS 6.5, Duolingo 120 or Cambridge 176",
            "Prepare a CV of no more than two pages and a statement of purpose that explains your mathematical background in detail",
            "Contact your two referees before submitting, because they must upload their own signed letters",
            "Budget for the €100 non-refundable application fee and pay by credit card or Flywire",
            "Include a GRE score if you are applying to the PhD Track Program"
          ],
          "common_rejection_risks": [
            "Missing the 15 January funding cut-off and being considered only for leftover funds",
            "Applying for the Ramón Areces or Unicredit scholarships through a programme outside the Economics or Finance Program",
            "An incomplete file because a referee has not uploaded their letter: 'Your application is not considered complete until both letters have been uploaded'",
            "Not submitting an English certificate when required, which invalidates the application",
            "A CV longer than two pages, which falls outside the stated format",
            "A statement of purpose that does not demonstrate quantitative and mathematical preparation"
          ],
          "estimated_uncovered_costs": [
            "Housing and living expenses, which the official page states tuition does not cover",
            "The tuition balance if the waiver is 25%, 50% or 75% rather than 100%",
            "The €100 application fee, which is non-refundable",
            "Travel to and from Barcelona",
            "Any additional stipend beyond 100% of fees, which is available only on a limited number of awards"
          ],
          "document_audit": [
            "Undergraduate transcripts or mark sheets",
            "Undergraduate diploma copy, or the signed declaration if the degree is pending",
            "Passport copy",
            "CV of a maximum of 2 pages",
            "Statement of purpose including your mathematical background",
            "TOEFL, IELTS, Duolingo or Cambridge certificate",
            "Two signed reference letters uploaded by the referees",
            "GRE score for PhD Track applicants",
            "Payment confirmation for the €100 application fee"
          ],
          "alerts": [
