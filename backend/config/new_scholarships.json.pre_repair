    {
      "name": "DAAD Helmut-Schmidt-Programme (Master's Scholarships for Public Policy and Good Governance - PPGG)",
      "legacy_titles": [
        "DAAD Helmut-Schmidt-Programme",
        "DAAD Helmut-Schmidt-Programme (Public Policy and Good Governance)"
      ],
      "country": "Germany",
      "region": "Global",
      "degree_levels": "Master's",
      "funding_type": "Full Master's Scholarship",
      "official_source": "DAAD (German Academic Exchange Service)",
      "official_source_url": "https://www2.daad.de/deutschland/stipendium/datenbank/en/21148-scholarship-database/?detail=50018884",
      "status": "upcoming",
      "is_verified": true,
      "last_verified_date": "2026-10-04",
      "description": "The DAAD Helmut-Schmidt-Programme, also known as Public Policy and Good Governance, is funded by the German Federal Foreign Office and supports future leaders from developing and emerging countries who want to promote democracy and social justice in their home regions. It funds places on selected English-taught master's courses in public policy, good governance, international relations, public management, public administration, civil society, geo-governance, peace and conflict studies, and development and socio-economic policy at seven German higher education institutions. Applications go directly to the participating universities rather than to the DAAD, and the published application window is 1 June to 31 July each year, with the 2027-intake round closed on 31 July 2026.",
      "funding_amount": null,
      "funding_currency": "EUR",
      "funding_period": "for the full duration of the funded master's course",
      "deadline": "\"The application period for all seven higher education institutions is from 1 June until 31 July 2026\", with the application deadline being 31 July each year",
      "deadline_date": null,
      "deadline_precision": "recurring",
      "application_period": "1 June to 31 July each year, applied for directly at the participating universities. The 2027-intake round closed on 31 July 2026, before the verification date.",
      "duration": "Duration of the selected master's course, normally two years; preceded by a German language course in Germany of up to six months",
      "program_type": "Full master's scholarship for public policy and governance studies at selected German universities",
      "eligibility_summary": "Very well qualified graduates with a first university degree (Bachelor or equivalent) from a developing or emerging country, both young graduates without professional experience and mid-career professionals, who want to contribute to the social and economic development of their home country or region.",
      "eligibility": [
        "Very well qualified graduate with a first university degree (Bachelor or equivalent)",
        "National of or normally resident in a developing or emerging country on the DAAD list of eligible countries",
        "Wants to actively contribute to the social and economic development of their home country or region",
        "Both young graduates without professional experience and mid-career professionals may apply",
        "First academic degree in political science, law, economics or administration, or a related field relevant to social, political and economic development",
        "Must have completed the first degree by the closing date of the application round",
        "Academic admission to the chosen master's course at one of the participating institutions"
      ],
      "coverage": [
        "Full scholarship for the selected master's course at a participating German university",
        "German language course in Germany of up to six months before starting the master's studies",
        "Scholarship holders study in small groups with special tutoring at the host institution",
        "Networking events across courses and tailor-made workshops"
      ],
      "benefits": [
        "Full scholarship for one of the selected master's courses at a participating German institution",
        "German language course in Germany lasting up to six months before the master's studies",
        "Special tutoring at the host institution and study in small groups",
        "Networking events across courses and tailor-made workshops"
      ],
      "required_documents": [
        "DAAD application form for Research Grant and Study Scholarships",
        "Checklist for the Helmut-Schmidt-Programme",
        "Documents required by the chosen master's course, as specified by that university",
        "The application must be submitted to the master's course of your choice, not to the DAAD"
      ],
      "requirements": [
        "Apply directly to the master's course or courses at the participating universities, and not to the DAAD",
        "The application period for all participating institutions is 1 June to 31 July each year",
        "Graduation must be completed by the end of the application round, since the DAAD FAQ states that candidates who will not graduate until 31 July cannot be admitted to that application round",
