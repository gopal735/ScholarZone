        "CEEPUS Exchange Programme"
      ],
      "country": "Czechia, Hungary, Poland, Slovakia",
      "degree_levels": "Varies by network (undergraduate, master's or doctoral level, following the sending institution's programme)",
      "funding_type": "Fully Funded",
