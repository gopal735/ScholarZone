    {
      "name": "Japanese Government (MEXT / Monbukagakusho) Scholarship",
      "legacy_titles": [
        "MEXT (Monbukagakusho) Scholarship"
      ],
      "country": "Japan",
      "degree_levels": "Bachelor's, Master's, PhD, Professional Graduate",
