            },
            {
              "trigger": "Referee letters",
              "message": "Both referees must upload their signed letters directly to the application system or the application is incomplete."
            },
            {
              "trigger": "Tuition does not cover living costs",
              "message": "Published 2027-28 tuition is €18,500 (most programmes) and €20,000 (Data Science programmes), and 'they do not cover housing or living expenses'."
            }
          ],
          "submission_workflow": [
            "Choose up to three BSE Master's programmes",
            "Create your account in the BSE Application System at apply.bse.eu",
            "Complete the application questions, including finance and scholarship details",
            "Upload transcripts, diploma or declaration, passport, CV, statement of purpose and English proof",
            "Give your two referees the contact details BSE needs and remind them to watch for BSE's instructions email",
            "Pay the €100 fee by credit card or Flywire and submit before 15 January",
            "Track your status in the application system and wait for the combined admissions and financial aid email"
