    {
      "name": "Roberta Sykes Scholarship",
      "country": "Australia",
      "region": "Australia",
      "degree_levels": "Doctoral Research, Postgraduate Coursework, Postgraduate Research",
      "funding_type": "Partially Funded",
      "program_type": "Charitable foundation scholarship (Aboriginal and Torres Strait Islander postgraduate students, overseas study)",
      "official_source": "Aurora Education Foundation",
      "official_source_url": "https://aurorafoundation.com.au/our-work/indigenous-pathways-portal/scholarships/roberta-sykes-scholarship/",
      "catalogue_url": "https://aurorafoundation.com.au/our-work/indigenous-pathways-portal/scholarships",
      "official_updates_url": "https://aurorafoundation.com.au/our-work/study-tours-and-scholarships-scholarships-international-scholarships-robertasykesscholarship/",
      "status": "upcoming",
      "is_verified": true,
      "last_verified_date": "2026-10-04",
      "description": "The Roberta Sykes Scholarship provides supplementary financial assistance to Aboriginal and Torres Strait Islander postgraduate students undertaking full-time study at a recognised overseas university. It is administered by the Aurora Education Foundation and jointly funded by the Australian Government through the National Indigenous Australians Agency, the British High Commission through Chevening, Cambridge Australia Scholarships Ltd, the Cambridge Commonwealth Trust and the University of Cambridge. The value is up to AUD 75,000, paid directly to the recipient in equal instalments at the start of each semester or term and subject to academic progress. The portal publishes a window opening 5 October 2026 and closing 29 January 2027.",
      "duration": "Paid in equal instalments at the start of each semester or term, subject to academic progress",
