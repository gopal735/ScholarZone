        "applicant_utility": {
          "application_readiness_checklist": [
            "Confirm you are a new international student entering a coursework degree - domestic students and continuing students are not eligible",
            "Check your degree is not the Doctor of Medicine (H911), which is excluded outright",
            "Verify you meet the 85% average or equivalent threshold, translating your qualification into one of Deakin's stated examples",
            "Start early: your email must reach Deakin International Admissions at least one month before your program starts, and assessment rolls through the trimester lead-up",
            "Write a genuine 300-word personal statement in your own voice covering why Deakin, your extracurricular or work experience, and what makes you a strong ambassador",
            "Secure two references that specifically speak to community involvement and/or leadership, not just academics",
            "Attach your program application and academic transcripts to the package",
            "Read the acceptance form terms carefully, including the VCPEP participation requirement",
            "Factor in on-campus living costs: accommodation priority access is at your own cost"
          ],
          "common_rejection_risks": [
            "Missing the one-month-before-start email deadline, because there is no published calendar date to fall back on",
            "Applying to the Doctor of Medicine (H911) program",
            "An average below 85% or its stated equivalents",
            "Being a domestic or continuing student rather than a new international student",
            "References that describe academic ability only, without community involvement or leadership",
            "A personal statement that reads as generic marketing rather than the applicant's own voice",
            "Assuming the award is always 100% of fees - it may be only 50%",
            "Assuming extra or repeated units are covered; they are not"
          ],
          "estimated_uncovered_costs": [
