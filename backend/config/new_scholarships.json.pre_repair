            "Confirmation of automatic consideration received within seven days",
            "Academic transcripts from previous study",
            "Evidence of research output or publications, where relevant to the selection panel",
            "Evidence of professional experience or specialist medical qualifications, where relevant",
            "Student visa details, where OSHC Single Membership is to be provided"
          ],
          "alerts": [
            {
              "trigger": "No separate application",
              "message": "\"No application required.\" If you apply for a graduate research course by its closing date you are automatically considered, and confirmation arrives within seven days."
            },
            {
              "trigger": "Domestic students are handled differently",
              "message": "\"Domestic research students will receive an offer for Research Training Program Scholarship (Fee offset) together with their course offer.\" Stipend and fee offset offers are made separately, around the same time as course offers."
            },
