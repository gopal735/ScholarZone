          "general_eligibility": [
            "All applicants must be U.S. citizens who are 18 or older and matriculated at an accredited U.S. institution, proposing a continuous overseas programme of 12 weeks or more (8 weeks for undergraduate STEM summer programmes) with at least 15-20 weekly classroom language hours, in a country outside Western Europe, Canada, Australia and New Zealand and of which they are not a citizen"
          ],
          "ineligibility_conditions": [
            "Only U.S. citizens are eligible for the scholarship. No permanent residents or international students are eligible.",
