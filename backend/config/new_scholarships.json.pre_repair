    {
      "name": "Monbukagakusho Honors Scholarship for Privately-Financed International Students",
      "legacy_titles": [
        "JASSO Monbukagakusho Honors Scholarship"
      ],
      "country": "Japan",
      "region": "East Asia",
      "degree_levels": "Bachelor's, Master's, PhD, Postgraduate certificate, Diploma",
      "funding_type": "Stipend",
      "official_source": "Japan Student Services Organization (JASSO)",
      "official_source_url": "https://www.jasso.go.jp/en/ryugaku/scholarship_j/shoreihi/about.html",
      "status": "open",
      "is_verified": true,
      "last_verified_date": "2026-10-04",
      "deadline": "No central closing date is published; JASSO states 'Method of application: Please ask the staff at the educational institution in which you are enrolled', so timing is set by each institution.",
      "deadline_date": null,
      "deadline_precision": "varies",
      "application_period": "Continuous at institutional level; JASSO publishes selection results annually (2026 results posted 2026-06-05).",
      "application_method": [
        "Ask the international student office at your enrolled Japanese educational institution about the scholarship",
        "Have the institution screen you against the JASSO grant conditions and ranking criteria",
        "The institution submits its recommendation to JASSO",
        "Sign the JASSO-designated sheet every month at the international students' office after the award starts"
      ],
      "eligibility_summary": "For privately-financed international students enrolled full-time in Japan with excellent academic and character records who are facing financial difficulties. A privately-financed student is one enrolled in a Japanese institution who is not a grantee of the Japanese Government (Monbukagakusho) Scholarship or any Foreign Government Scholarship and who holds 'Student' residence status. Candidates must not exceed a monthly allowance of 90,000 yen excluding tuition and enrollment fees, and any financial supporter in Japan must earn under 5 million yen per year.",
      "eligibility": [
        "Privately-financed international student (not a Monbukagakusho or foreign government scholarship grantee) holding 'Student' residence status",
        "Enrolled full-time in an undergraduate school, junior college, college of technology (3rd year or above), specialized course in a specialized training college, or advanced course thereof in Japan",
        "Enrolled full-time in a graduate school in Japan, or holds an undergraduate degree and is enrolled as a research student at graduate level",
        "Enrolled full-time in a preparatory Japanese language program in an undergraduate school or junior college in Japan",
        "Enrolled full-time in a university preparatory course in Japan with the objective of entering university",
        "Enrolled in a Japanese language institute with the objective of advancing to higher education in Japan",
        "Excellent academic and character records and facing financial difficulties",
        "Monthly allowance excluding enrollment fee and tuition must not exceed an average of 90,000 yen",
        "If financially supported by someone in Japan, that supporter's annual income must be below 5 million yen"
      ],
      "coverage": [
        "Monthly stipend of JPY 48,000 for graduate and undergraduate level students",
        "Monthly stipend of JPY 30,000 for students at Japanese language institutes"
      ],
      "required_documents": [
        "Documents required by the enrolled institution for its internal scholarship screening (JASSO publishes no single document list)",
        "Monthly signature on the sheet designated by JASSO at the international students' office"
      ],
      "english_requirement": "Candidates (except those in preparatory Japanese language programs, university preparatory courses and Japanese language institutes) must be at CEFR B2 level or higher in English, or meet the equivalent Japanese requirement (JLPT N2 or higher, EJU Japanese score of 200 or more, or a level separately recognised by JASSO).",
      "catalogue_url": "https://www.jasso.go.jp/en/ryugaku/scholarship_j/index.html",
      "official_updates_url": "https://www.jasso.go.jp/en/ryugaku/scholarship_j/shoreihi/index.html",
      "duration": "12 months (April to the following March) or 6 months (October to the following March)",
      "funding_amount": 48000,
      "funding_currency": "JPY",
      "funding_period": "per month",
      "program_type": "Government-funded scholarship for privately-financed international students administered by JASSO (an Independent Administrative Institution)",
      "best_fit": "Privately-financed international students already enrolled full-time at a Japanese institution who have financial difficulties and meet JASSO's language and allowance conditions.",
      "notes": "The scholarship is a monthly stipend only; JASSO publishes no tuition waiver. The number of students an institution can recommend depends on its enrolment of international students, and JASSO warns that 'depending on your educational institution, you may not be able to apply'. JASSO states there are currently no universities or Japanese language institutes suspended from applying.",
      "description": "The Monbukagakusho Honors Scholarship for Privately-Financed International Students is a JASSO programme for privately-financed international students with excellent academic and character records who are already enrolled at a Japanese educational institution and are facing financial difficulties. It pays a monthly stipend of 48,000 yen at graduate or undergraduate level and 30,000 yen at Japanese language institutes, for 12 months from April or 6 months from October. Applications are made through the enrolled institution rather than directly to JASSO, so timing and eligibility are institution-specific.",
      "detail": {
        "official_details": {
          "official_source_urls": [
            "https://www.jasso.go.jp/en/ryugaku/scholarship_j/shoreihi/about.html"
          ],
          "application_link": "https://www.jasso.go.jp/en/ryugaku/scholarship_j/shoreihi/about.html",
          "official_updates_url": "https://www.jasso.go.jp/en/ryugaku/scholarship_j/shoreihi/index.html",
