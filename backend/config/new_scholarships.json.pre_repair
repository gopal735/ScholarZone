        "applicant_utility": {
          "application_readiness_checklist": [
            "Confirm your nationality or permanent legal residence is that of an OAS Member State and that it is not Nicaragua.",
            "Confirm the programme you are applying to is not in your own country of origin.",
            "Check which of the three 2a convocatoria deadlines applies to your institution and programme: 19 October, 26 October or 30 October 2026.",
            "Complete the institution's admission process and pay the admission fee, which the scholarship does not cover.",
            "Obtain the institution's carta de aplicacion, which is what makes you a scholarship candidate automatically.",
            "Prepare evidence of your own financial capacity for the tuition the discount does not cover, plus admission, translation/notarisation, materials and titulation costs.",
            "Review the exact programme cost with the institution, because the call states the costs shown in the document are orientative and may be lower in some countries.",
            "Confirm with your own Ministry of Education how the resulting title will be recognised, since neither the OAS nor the institutions take responsibility for that."
          ],
          "important_advice_for_students": [
            "There is no scholarship application form. You become a candidate the moment you are admitted and receive the carta de aplicacion, so the real deadline you are racing is your institution's admission deadline, not an OAS deadline.",
            "Do the arithmetic before you apply. Even at 60% off, you personally fund 40% of the entire programme cost, and the call explicitly excludes admission, materials, certificates, titulation and degree costs from the scholarship.",
            "The admission fee is non-refundable and gives you no right to the scholarship. The call tells you to check the cost with the institution before paying it.",
            "You can decline free of penalty up to one week before classes start. After that, declining without force majeure risks a demand for the full amount invested.",
            "There is a work commitment. You must work in your country of origin or of legal residence, in an OAS Member State, or in an international organisation, for at least the length of the scholarship, or repay the total award.",
            "Keep your grades above 5/10 in every academic period and pass everything within the programme's timeframe, or the institutions can demand repayment of the value invested.",
            "Nobody will tell you why you were not selected. The OAS publishes no individual feedback, so do not expect an appeal route."
          ],
          "common_rejection_risks": [
            "Missing the institutional deadline: the lines close on different dates, 19, 26 and 30 October 2026, and there is no common later date.",
            "Nicaraguan nationality or permanent legal residence, which is excluded.",
            "Applying to study in your own country of origin, which is not permitted.",
            "Holding another OAS scholarship at the same level of study.",
            "Not completing admission, or not paying the admission fee, before the deadline.",
            "Being an SG/OAS official, a person under a results-based contract with the SG/OAS, Permanent Mission personnel, or a family member of any of them.",
            "Dropping below an average of 5/10, or being reported with baja academica for absences or failed subjects, which puts the scholarship at risk.",
            "Assuming the scholarship covers costs beyond the tuition discount, and then failing the proof-of-funds step."
          ],
          "estimated_uncovered_costs": [
            "The remaining 40% of tuition for official master's and official degree programmes, and 50% for UNIR Formacion Permanente.",
            "The admission fee (cuota de admision), which must be paid to be admitted and is not covered.",
            "Translation and notarisation or authentication of documents.",
            "Study materials.",
            "Titulation procedures and obtaining the degree.",
            "Issuance of certificates or constancias, admission examinations and graduation services.",
            "Any other cost not listed in the call.",
            "All living costs, travel and health insurance, which the call does not address at all."
          ],
          "document_audit": [
            "The institution's carta de aplicacion, issued once admitted, is the essential item: without it there is no scholarship candidacy.",
            "The admission fee receipt, since admission requires payment of that fee.",
            "All documentation the institution itself requires for admission.",
            "Evidence of financial capacity for the uncovered costs, to be presented within the established period before starting the programme.",
            "The call does not enumerate a separate scholarship document list, and it publishes no format, size, translation or date rule for any document, so institution-level admission requirements govern."
          ],
          "referee_tracking": [
            {
              "role": "Host institution admissions office (UNIR, EP NEWMAN or UNIR Mexico)",
              "required": true,
              "instructions": "Not an academic referee. The call states no referee, recommendation or reference letter is part of the process. The institution's admissions office is nonetheless the controlling contact: it runs the admission, issues the carta de aplicacion that generates the candidacy, and sends the offer and acceptance instructions by email to selected candidates only. Admissions contact: atencion.estudiante@unir.net, +34 91 567 44 94."
            }
          ],
          "alerts": [
            {
              "trigger": "You are budgeting for this award",
              "message": "It is a percentage tuition discount, not a fixed grant. You still pay the balance of tuition plus admission, materials and titulation, and there is no living stipend."
            },
            {
              "trigger": "You are choosing between UNIR, EP NEWMAN and UNIR Mexico",
