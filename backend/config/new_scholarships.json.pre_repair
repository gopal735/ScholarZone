    {
      "name": "Jagiellonian University Rector's Scholarship (stypendium rektora)",
      "legacy_titles": [
        "Jagiellonian University Rector's Scholarship for International Students"
      ],
      "country": "Poland",
      "degree_levels": "Bachelor's, Master's, Long-cycle Master's",
      "funding_type": "Stipend",
      "official_source": "Jagiellonian University (Krakow)",
      "official_source_url": "https://stypendia.uj.edu.pl/en_GB/pomoc-materialna/cudzoziemcy",
      "status": "open",
      "is_verified": true,
      "last_verified_date": "2026-10-04",
      "region": "Europe",
      "description": "Jagiellonian University's Rector's Scholarship is a merit-based cash benefit from the university Scholarship Fund for first-cycle (bachelor), second-cycle (master) and long-cycle master's students, awarded on request for outstanding academic performance, scientific, artistic or sports achievements. In the first year of first-cycle or long-cycle master's studies it goes to students admitted in the year of the matura exam who won an international olympiad or were laureates/finalists of a central-level olympiad, or who medalled in at least a Polish Championship competition; in higher years it is capped at 10% of students in a given programme. Foreign students admitted from the 2019/2020 academic year onward may apply regardless of citizenship. The award runs for nine months (October to June), paid monthly into a Polish zloty (PLN) bank account held at a bank in Poland.",
      "deadline": "Official wording: \"The deadline for submitting the application for the Rector's scholarship is October 20 of the academic year for which the scholarship is to be awarded.\" The last published schedule (2025/2026) showed applications open from 1 to 20 October.",
      "deadline_date": null,
      "deadline_precision": "recurring",
      "application_period": "Annual. Published 2025/2026 schedule: rector's scholarship applications from 1 October to 20 October, submitted electronically in USOSweb.",
      "eligibility_summary": "Enrolled in first-cycle, second-cycle or long-cycle master's studies at Jagiellonian University; not available to students who already hold a master's degree (or a bachelor's degree when re-enrolling in first-cycle studies), including degrees obtained abroad; not available to conditionally enrolled students, students who repeated a year without completing the next one, or students resuming after removal from the student list. Foreign students admitted from 2019/2020 onward qualify regardless of citizenship. Total eligibility is 12 semesters, with a maximum of 9 semesters for first-cycle and 7 for second-cycle studies.",
      "eligibility": [
        "Enrolled in first-cycle, second-cycle or long-cycle Master's studies at Jagiellonian University",
        "First year of first-cycle or long-cycle Master's studies and admitted in the year of the secondary school-leaving exam (matura), and a winner of an international olympiad or winner/finalist of a central-level olympiad, or a medalist in at least the Polish Championship competition in a sport",
        "Higher years: outstanding academic performance, scientific or artistic achievements, or sports achievements at least at national level",
        "First-year second-cycle (master's) students may apply on the basis of the GPA and achievements from the final year of their first-cycle studies, provided they started the master's programme in the year they completed the bachelor's",
        "Foreign students admitted from the 2019/2020 academic year onward, regardless of citizenship or study terms",
        "Must not already hold a master's degree, nor a bachelor's degree when re-enrolling in first-cycle studies, including degrees obtained abroad"
      ],
      "coverage": [
        "Monthly cash stipend paid October to June (9 months per academic year)",
        "Paid by bank transfer to a Polish zloty (PLN) account at a bank operating in the territory of the Republic of Poland",
        "Tax-exempt in Poland and not declared in the annual Polish tax return"
      ],
      "required_documents": [
        "Certificates confirming every circumstance cited in the application, attached electronically to the application in USOSweb",
        "For first-year second-cycle students who completed first-cycle studies at another university: a certificate confirming the arithmetic GPA for the last year of first-cycle studies (the bachelor's thesis defence grade is excluded)"
      ],
      "catalogue_url": null,
      "official_updates_url": "https://stypendia.uj.edu.pl/en_GB/aktualnosci",
      "english_requirement": null,
      "requirements": [
        "Applications for benefits must be submitted online only via the USOSweb system using the \"Sign and submit\" function",
        "Applications must be submitted within the deadline; order of submissions does not matter",
        "All achievements must be confirmed with an appropriate certificate attached electronically to the application in USOSweb",
        "Achievements reported after submission of the application are not taken into account",
        "The scholarship holder must provide a bank account denominated in Polish zloty (PLN) with a bank operating in Poland"
      ],
      "application_method": [
        "Log in to USOSweb",
        "Go to the \"For everyone\" tab, then \"Applications\"",
        "Choose the rector's scholarship application and use the \"sign and submit electronically\" function"
      ],
      "selection_notes": "Applications are assessed with a points-based system awarding points for grade average plus academic, artistic and sports achievements; the scholarship goes to students with the highest number of points and is capped at 10% of students per programme/specialisation. For first-year second-cycle students, two separate ranking lists are used (JU graduates by weighted GPA, graduates of other universities by arithmetic GPA), with 10% awarded from each. Ties are broken by: points for academic/artistic/sports achievements, then ECTS credits obtained, then the grade average over the entire course of studies, then the admission result for first-year second-cycle students.",
      "program_type": "Merit-based university scholarship from the Jagiellonian University Scholarship Fund (Polish: stypendium rektora)",
      "benefits": [
        "Monthly cash stipend for nine months (October to June)",
        "Can be combined with the Rector's Fund for Olympiad Participants"
      ],
      "funding_amount": null,
