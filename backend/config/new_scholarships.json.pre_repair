    {
      "name": "Radboud Scholarship Programme",
      "legacy_titles": [
        "Radboud Scholarship Programme"
      ],
      "country": "Netherlands",
      "degree_levels": "Master's",
      "funding_type": "Partially Funded",
      "official_source": "Radboud University",
      "official_source_url": "https://www.ru.nl/en/education/scholarships/radboud-scholarship-programme",
      "status": "open",
      "is_verified": true,
      "last_verified_date": "2026-10-04",
      "description": "The Radboud Scholarship Programme is a highly selective Radboud University scheme for talented, highly motivated non-EU/non-EEA students with outstanding study results, covering English-taught Master's programmes. A scholarship reduces the tuition fee to EUR 2,771 (the university notes the amount is to be confirmed) instead of an illustrative EUR 19,000, and additionally covers visa, residence permit, health insurance and liability insurance costs. Costs of living and studying in the Netherlands are not covered. A maximum of 26 scholarships are available for 2027/2028, allocated across six faculties, and selection is based on academic excellence, ambition and the quality of two reference letters.",
      "region": "Europe",
      "duration": "Nominal duration of the Master's programme",
      "deadline": "Two official deadlines: \"You must have submitted your application in the online OSIRIS Application system on 31 January 2027 23:59 CET at the latest\", after which the application must be complete \"by 14 February 2027 23:59 CET at the latest\" and \"incomplete applications will not be considered for the scholarship selection\". Final decisions are notified before mid-April 2027.",
      "deadline_date": "2027-01-31",
      "deadline_precision": "exact",
      "application_period": "Annual cycle for the September 2027 intake. OSIRIS submission by 31 January 2027 23:59 CET, complete application by 14 February 2027 23:59 CET, decision before mid-April 2027.",
      "eligibility_summary": "Applicants must hold a non-EU/non-EEA passport, not qualify for the lower EU/EEA tuition fee for other reasons, hold a Bachelor's degree obtained outside the Netherlands with no Dutch degrees and no prior education in the Netherlands, meet the English proficiency requirement of the chosen Master's programme, be fully admitted to an English-taught Master's programme starting 1 September 2027, be able to comply with Dutch visa conditions, and enrol as a full-time Radboud student.",
      "eligibility": [
        "Hold a non-EU/non-EEA passport",
        "Are not eligible for the lower EU/EEA tuition fee for other reasons",
        "Have (will obtain) a Bachelor's degree achieved outside the Netherlands, have no degrees achieved in the Netherlands and did not receive any previous education in the Netherlands (exchange programmes excluded, provided they are part of the Bachelor's degree achieved outside the Netherlands)",
        "Meet the English language proficiency requirement for the Master's programme of your choice",
        "Have been fully admitted to the English-taught Master's programme starting 1 September 2027 as stated in the formal letter of admission",
        "Are able to comply with the conditions for obtaining a visa for the Netherlands",
        "Are enrolled at Radboud University as a full-time student for the academic year and Master's programme for which the scholarship will be awarded"
      ],
      "coverage": [
        "Reduction of the tuition fee to EUR 2,771 (amount to be confirmed), against an illustrative full fee of EUR 19,000",
        "Visa costs",
        "Residence permit costs",
        "Health insurance (Aon Student Insurance)",
        "Liability insurance"
      ],
      "required_documents": [
        "Two reference letters (preferably two academic references)",
        "Curriculum vitae",
        "Proof of English proficiency (recommended before the 14 February 2027 deadline)"
      ],
      "english_requirement": "Meet the English language proficiency requirement for the Master's programme of your choice.",
      "application_method": [
        "Indicate during the OSIRIS Application System application for admission to a Master's programme that you wish to apply for a Radboud Scholarship",
        "Upload the three additional scholarship documents requested by the system: two reference letters and a curriculum vitae",
        "Documents already uploaded for the Master's programme application may be uploaded again for the scholarship application"
      ],
      "selection_notes": "Selection is by the selection committee of the faculty applied to and is based on academic excellence (outstanding study results, relevancy of the previous degree, ranking of the university where the previous degree was obtained), ambition (quality and relevance of the motivation letter, promise based on previous achievements, life experience and extracurricular activities such as internships or volunteering) and references (quality of two reference letters, preferably two academic references). Faculties may apply additional criteria and some study programmes hold interviews. Admission to the Master's programme is a separate process and does not imply selection for the scholarship.",
      "program_type": "Partial tuition-fee scholarship awarded by the university, merit-based",
      "best_fit": "Non-EU/non-EEA applicants with outstanding study results who hold a Bachelor's degree from outside the Netherlands and are admitted to an English-taught Radboud Master's programme starting September 2027.",
      "notes": "All English-taught Master's programmes are eligible except Erasmus Mundus Master's programmes and joint-degree Master's programmes. The scholarship can be combined with the NL Scholarship. If admitted to a two-year Master's programme, grant holders must pass all courses in the first year to qualify for the grant again in the second year. The scholarship is funded by the Profiling Fund of Radboud University and its requirements follow that fund's regulations.",
      "benefits": [
        "Tuition fee reduced to EUR 2,771 (amount to be confirmed)",
        "Visa costs covered",
        "Residence permit costs covered",
        "Health insurance (Aon Student Insurance) covered",
        "Liability insurance covered"
      ],
      "funding_amount": null,
      "funding_currency": null,
      "funding_period": null,
      "detail": {
        "official_details": {
