      "name": "Dos becas de investigacion: sedes Costa Rica y Ecuador (Fellowships CALAS 2027)",
      "country": "Costa Rica",
      "region": "Latin America",
      "degree_levels": "PhD",
      "funding_type": "Fully Funded",
      "program_type": "Research institute visiting research fellowship",
      "official_source": "Centro Maria Sibylla Merian de Estudios Latinoamericanos Avanzados (CALAS)",
      "official_source_url": "https://www.cucsh.udg.mx/convocatorias/fellowships-calas-2027-costa-rica-y-ecuador",
