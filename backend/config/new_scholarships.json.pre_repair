        "applicant_utility": {
          "application_readiness_checklist": [
            "Confirm you fall into one of the three published groups: PhD student outside Austria, postgraduate/postdoc who completed studies abroad after 30 September 2025, or postdoc employed at a university outside Austria",
            "Check the age limit: you must be 35 or under at the start of the stay, i.e. born on or after 1 October 1991",
            "Confirm you have not lived, studied, researched or worked academically in Austria in the last six months, and interrupt any current Austrian stay if you apply",
            "Approach an Austrian university professor directly and obtain the supervision consent on the OeAD template",
            "Request two recommendation letters from university lecturers that are not your Austrian supervisor, each with letterhead, date, signature and university/department stamp",
            "Check that your letters and consent letter are not older than six months at the time of application",
            "Scan your biometric passport (name and photo page) and your graduation certificate",
            "Add your PhD-programme participation confirmation or employment confirmation depending on your status",
            "Plan a stay in whole months between 1 and 9 months within the 2027/28 academic year, ending before the end of 2028",
            "Budget for accommodation and health insurance yourself and be ready to prove funds to the residence authority if accommodation exceeds EUR 386.43/month",
            "Write the application sections before the deadline, observing the minimum word counts, and declare any generative AI use"
          ],
          "important_advice_for_students": [
            "Do not plan to use this grant to start a degree in Austria – it cannot finance a Master or PhD programme there",
            "Do not ask your Austrian supervisor for a recommendation letter as well as the supervision consent; the reference will be treated as invalid",
            "Do not apply for a stay that has already begun or for your current Austrian stay",
            "Do not assume the EUR 1,300 per month is enough: the OeAD labels it a supplementary grant and states own funds are required",
            "Do not leave the recommendation letters to the last week; if a professor sends one by e-mail, the OeAD still has to upload it to your file and must have it before the deadline",
            "Do not submit documents after the deadline; they will not be accepted",
            "Do not rely on a certified translation; an official certified translation is not required, but the original must always be uploaded alongside the translation",
            "If you plan a stay of more than 6 months and are a non-EU national, start the visa process immediately after the Letter of Award, as the process can take several months",
            "If you intend to work at all, remember gainful employment is prohibited and only marginal employment of EUR 551.10 per month (2026) is exempt"
          ],
          "common_rejection_risks": [
            "Missing or unverifiable supervision consent from an Austrian lecturer – the Austrian supervisor must confirm they will supervise and that the project can be done in English",
            "Age over 35 at the start of the stay",
            "Having studied, lived or worked academically in Austria in the preceding six months, or being permanently resident in Austria",
            "Completing studies before 30 September 2025 and claiming eligibility as a recent graduate",
            "Letters of recommendation older than six months, missing letterhead, date, signature or university/department stamp",
            "Using the Austrian supervisor also as a referee, which invalidates the reference",
            "Non-biometric passport scan, or an identity card from a non-EU country",
            "Missing translation of a document that is in neither English nor German, or failing to upload the original alongside the translation",
            "Failing the minimum word counts or describing the research stay too thinly, which causes the application to be rejected as incomplete and formally invalid",
            "A project that cannot be completed within 9 months",
            "Missing the PhD-programme participation or employment confirmation for the relevant applicant category",
            "Submitting after the deadline – late documents cannot be accepted"
          ],
          "estimated_uncovered_costs": [
