          "degree_levels": [
            "Master's",
            "Doctoral"
          ],
          "study_type": [
            "Full-time graduate research study",
            "At the University of Calgary: open to thesis-based students undertaking a full-time graduate program in research areas that are strategically important to Alberta",
            "At the University of Calgary: NOT open to students in course-based and professional degree programs through the Graduate Award Competition"
          ],
          "degree_award": "The award attaches to a full graduate degree; at the University of Calgary the published terms run up to two years for master's and up to four years for doctoral study.",
          "duration": "Terms vary from one to four years, depending on the recipient's time in the program.",
          "application_cycle": "Continuous at the funder level with a seasonal intake at each institution. Alberta Innovates publishes the due date as \"Continuous\" and states that the intake open date is specific to each individual university. At the University of Calgary the Graduate Award Competition opens November 1 of each year, with program deadlines varying.",
          "deadline_central": null,
          "deadline_central_display": "Continuous (Alberta Innovates published due date); institutional open date is specific to each individual university",
          "deadline_institutional": "At the University of Calgary: the Graduate Award Competition opens November 1 of each year and deadlines vary by program (BISI, EDER, PSYC, etc.); contact your Graduate Program Staff. The Faculty of Graduate Studies reference deadline is February 1, and references must have been written within the eleven months prior to that deadline.",
          "deadline_note": "Because the funder publishes a continuous due date and states that institutional open dates vary, no single deadline date is published and deadline_date and deadline_precision are left null rather than inferred.",
          "status": "OPEN",
