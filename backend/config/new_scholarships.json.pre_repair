          "description": "The India Science and Research Fellowship (ISRF) is funded by the Department of Science and Technology, Government of India, and administered and published by the Indian National Science Academy. It enables researchers holding permanent positions in Afghanistan, Bangladesh, Bhutan, Maldives, Myanmar, Nepal, Sri Lanka and Thailand to carry out 3 to 6 months of research in India in frontier and advanced areas of science including medicine and agriculture. Up to 80 fellowships are awarded each year, ten per country. The award provides a monthly allowance, contingency grants, return air fare and visa fee reimbursement, but is a research visit rather than a degree programme.",
          "program_type": "Visiting research fellowship",
          "region": "Asia",
          "coverage": "Living allowance, host-side contingency grant, return economy air fare, local transport and visa fee. No tuition element because the award funds a research visit, not a taught degree.",
          "last_verified_date": "2026-10-04"
        },
        "applicant_utility": {
          "application_readiness_checklist": [
            "Confirm you are a citizen or permanent resident of one of the eight eligible countries and hold a permanent research position there",
            "Secure a letter of acceptance from an Indian host supervisor before submitting, as INSA can help identify a host if needed",
            "Get a No Objection Certificate from your home institution on official letterhead",
            "Prepare a write-up of the proposed research work and reprints of two recent refereed publications",
            "Check the age and the once-in-five-years rule against the stated cut-off date",
            "Route the endorsed application to your country implementing agency, or to INSA New Delhi if none exists"
          ],
          "common_rejection_risks": [
            "Not a citizen or permanent resident of one of the eight eligible countries",
            "Holding an Indian temporary or permanent residency visa",
            "Above the stated age limit or having used the fellowship within the previous five years",
            "Missing the institution head's endorsement on the form",
            "Incomplete enclosures, particularly the host supervisor acceptance letter and valid passport copy"
          ],
          "estimated_uncovered_costs": [
            "Local expenses in the home country and personal travel to the departure airport",
            "Any costs not covered by the Rs. 50,000 monthly allowance beyond the accommodation and medical facilities the host institute actually provides",
            "Visa-on-arrival or other personal documentation costs beyond the reimbursable visa fee",
            "Extended stay beyond the 3 to 6 month award period"
          ],
          "document_audit": [
            "Valid passport copy showing number, photograph, date of birth, issue and expiry dates and residential address",
            "Degree certificate for the highest qualification",
            "Two reprints of recent refereed publications",
            "No Objection Certificate from the home institution on letterhead",
            "Letter of Acceptance from the Indian host supervisor on letterhead",
            "Two passport size photographs",
            "Latest updated CV",
            "Brief write-up of the proposed research work"
          ],
          "alerts": [
            {
              "trigger": "Cycle closed",
              "message": "The 2025-26 call closed on 31 March 2026. Watch the INSA homepage from late December 2026 for the next call."
            },
            {
              "trigger": "Once-in-five-years rule",
              "message": "The fellowship may be taken only once in any five-year period; check your history before applying."
            },
            {
              "trigger": "Visa restriction",
              "message": "Applicants must not hold any Indian temporary or permanent residency visa."
            }
          ],
          "submission_workflow": [
            "Download the ISRF application form, brochure and announcement from the INSA ISRF call page",
            "Complete the form and gather all listed enclosures",
            "Obtain the No Objection Certificate from your institution and the head's endorsement",
            "Obtain the letter of acceptance from the Indian host supervisor",
            "Submit to the partner-country implementing agency if one exists, otherwise post or courier to INSA, New Delhi with a copy to DST/INSA",
            "Retain proof of submission and track correspondence with INSA"
          ]
        },
