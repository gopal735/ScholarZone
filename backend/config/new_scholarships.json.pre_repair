          "supplements_or_initiatives": [
            "UTS also runs a parallel UTS Vice-Chancellor's International Postgraduate Scholarship, confirmed by UTS as one of its two main full-tuition scholarships for international students"
          ],
          "official_contacts": {
            "team": "UTS Future Learner Recruitment and Admissions",
            "phone": "+61 2 9514 1531",
            "email": "reps@uts.edu.au"
          },
          "description": "The UTS Vice-Chancellor's International Undergraduate Scholarship was established to support high-achieving commencing international students enrolling in an undergraduate program at UTS in Sydney. Its value is UTS tuition fees for the standard duration of the course. Applicants must remain an international student, meet UTS admission criteria by the closing date, commence full-time on-campus study in Sydney, have completed a Year 12 or comparable qualification within three years and be admitted on it, hold an overall average of 85% where the pass mark is 50%, and submit the UTS online Scholarships Application form. Online and distance mode degrees and concurrent UTS International Grants or Scholarships are excluded. The scholarship is awarded to the highest ranked applicant on academic merit in the admission qualification combined with their scholarship application responses.",
          "program_type": "Academic merit",
          "region": "Oceania",
          "coverage": "Full UTS tuition fees for the standard duration of the course; no living-cost, stipend or travel component is listed",
          "last_verified_date": "2026-10-04"
        },
        "applicant_utility": {
          "application_readiness_checklist": [
            "Submit the UTS online Scholarships Application form before 11.55pm AEST on Monday 2 November 2026 - that is the exact cutoff for the Autumn session 2027 (February 2027) intake",
            "Meet UTS admission criteria for your chosen undergraduate program by the same closing date, not only the scholarship form",
            "Confirm your Year 12 or equivalent was completed within three years before you commence at UTS, because that is an eligibility condition",
            "Make sure you are being admitted on the basis of that high school qualification",
            "Convert your result to the UTS scale: an overall average of 85% where the pass mark is 50%, or equivalent",
            "Choose an on-campus Sydney degree, not an online or distance mode degree",
            "Make sure you are not holding another UTS International Grant or Scholarship, unless you have a documented exception in the Conditions of Award",
            "Answer the scholarship application questions carefully - they are weighed alongside academic merit in the ranking",
            "Plan for the fact that the award is tuition only, so build a living-cost budget for Sydney separately"
          ],
          "common_rejection_risks": [
            "Missing the 11.55pm AEST cutoff on 2 November 2026, which is unforgiving and closes at night",
            "Meeting admission criteria after the scholarship closing date",
            "Having completed Year 12 or equivalent more than three years before commencing at UTS",
            "Being admitted on a basis other than the qualifying high school qualification",
            "An overall average below 85% (where the pass mark is 50%) in the UTS-recognised high school qualification",
            "Enrolling in a UTS online or distance mode degree",
            "Already holding another UTS International Grant or Scholarship",
            "Submitting the UTS course application only and forgetting the separate online scholarship application form",
            "Assuming the scholarship also pays living costs, flights or OSHC"
          ],
          "estimated_uncovered_costs": [
            "All living costs - the value is UTS tuition fees only, with no stipend listed",
            "Overseas Student Health Cover and student visa charges, which UTS does not list as benefits of this scholarship",
            "Flights to Sydney and relocation costs",
            "Books, equipment and course-related costs not covered by the tuition fee offset",
            "Anything arising if the degree is transferred to an online or distance mode degree, or if another UTS International Grant is held, since scholarship status can be affected"
          ],
