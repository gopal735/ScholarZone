      "image_alt_text": "Japan Society for the Promotion of Science",
      "detail": {
        "official_details": {
          "description": "JSPS funds postdoctoral researchers from overseas to conduct collaborative research in Japan under the guidance of their hosts in universities and other research institutions in Japan. Financial support is a maintenance allowance of JPY362,000 per month, a round-trip air ticket, a settling-in allowance of JPY200,000, and overseas travel insurance. A Grant-in-Aid for Scientific Research for JSPS Research Fellows is available for cooperative research-related expenses.",
          "purpose": [
            "Enable overseas postdoctoral researchers to conduct collaborative research in Japan under the guidance of a Japanese host researcher, thereby advancing science in Japan and in other countries",
            "Advance the subject research through the host-candidate collaboration, on the published selection policy",
            "Contribute to the training of young researchers and to the formation of new international research networks, as reflected in the published document-review criteria (establishment of new research networks)",
            "Host applicants must have established contact with the candidate in advance and created a concrete research plan, so the fellowship funds an existing collaboration rather than starting one"
          ],
          "sdg_requirement": false,
          "sdg_requirement_details": [],
          "degree_levels": [
            "Postdoctoral"
          ],
          "study_type": [
            "Postdoctoral research fellowship",
            "Collaborative research under a Japanese host researcher",
            "Open-call recruitment administered by the host institution in Japan",
            "Research appointment, not a taught degree programme"
          ],
          "degree_award": "Not a degree programme. The fellowship is a research appointment as a JSPS Postdoctoral Fellow and awards no academic degree. JSPS normally does not issue documents certifying fellowship status; a Fellow who needs one, for example for a job application after the fellowship, may request the Application for the Issuance of Certificate (Form 17) at least two weeks before it is needed.",
          "duration": "12 to 24 months",
          "application_cycle": "Two open-call recruitments per year, with FY2027 1st results in late December 2026 and FY2027 2nd results in early August 2027.",
          "deadline_central": "2027-04-23",
          "deadline_central_display": "FY2027 2nd: April 23, 2027 (by 5 p.m. JST), application deadline from host institution to JSPS",
          "deadline_institutional": "Earlier than the JSPS deadline; the host institution may set its own deadline more than one month before the JSPS deadline.",
          "deadline_note": "The published deadline is the moment the host institution transmits the application to JSPS, not the moment the candidate submits material to the host. The effective deadline is therefore the host institution's internal deadline, which may fall more than one month earlier.",
          "status": "UPCOMING",
          "funding_type": "Stipend",
          "funding_label": "Maintenance allowance JPY362,000 per month, round-trip air ticket, settling-in allowance JPY200,000, overseas travel insurance",
