    {
      "name": "Horatio Alger Association National Scholarship",
      "country": "United States",
      "region": "United States",
      "degree_levels": "Bachelor's",
      "funding_type": "Partially Funded",
      "program_type": "Need-based scholarship from a non-governmental organisation",
      "official_source": "Horatio Alger Association of Distinguished Americans",
      "official_source_url": "https://horatioalger.org/scholarships-and-services/undergraduate-scholarships/",
      "catalogue_url": "https://horatioalger.org/scholarships/",
      "official_updates_url": "https://horatioalger.org/news-events/news/",
      "status": "upcoming",
      "is_verified": true,
      "last_verified_date": "2026-10-04",
      "description": "The Horatio Alger Association of Distinguished Americans, a 501(c)(3) educational nonprofit headquartered in Alexandria, Virginia, awards 105 National Scholarships of USD 25,000 each to high school juniors across all 50 states and Washington DC who intend to complete a bachelor's degree. Eligibility is explicitly need-based: applicants must have an adjusted gross family income of USD 100,000 or lower. Applicants also must show integrity and perseverance in overcoming adversity, be involved in co-curricular and community service, and maintain a minimum GPA of 2.0. One application is considered for all eligible Association scholarships. Admission to college is separate: the award does not include admission to any institution.",
      "funding_amount": 25000,
      "funding_currency": "USD",
      "funding_period": "per award over the course of the bachelor's degree",
      "duration": "Four-year undergraduate scholarship, renewed annually through the degree",
      "deadline": "Junior application period: December 1 - March 1; Senior application period: December 1 - February 15",
      "deadline_date": null,
      "deadline_precision": "recurring",
