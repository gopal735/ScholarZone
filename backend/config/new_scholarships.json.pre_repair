    {
      "name": "CTU Scholarship for Foreign Students - Czech Technical University in Prague",
      "legacy_titles": [
        "CTU Scholarship for Foreign Students of English Master's Degree Study Programmes"
      ],
      "country": "Czech Republic",
      "region": "Europe",
      "degree_levels": "Master's, Doctoral",
      "funding_type": "Stipend",
      "official_source": "Czech Technical University in Prague",
      "official_source_url": "https://international.cvut.cz/students/incoming-students/ctu-scholarships",
      "status": "open",
      "is_verified": true,
      "last_verified_date": "2026-10-04",
      "deadline": "No application deadline is published on the CTU Scholarships page. Applications are submitted to the Department of International Relations at the rectorate of CTU via the faculty International Office, with no published closing date or intake calendar.",
      "deadline_date": null,
      "deadline_precision": "unknown",
      "application_period": "No intake calendar or deadline is published. The page describes a standing procedure: obtain the faculty's agreement, then apply through the faculty International Office to the Department of International Relations at the rectorate.",
      "description": "CTU awards a scholarship to foreign students who wish to take a Master study programme at the Czech Technical University in Prague and display qualities that entitle them to the award, and to foreign doctoral students capable of doing scientific work who study on a doctoral programme in English at CTU in Prague. The Master's award is a contribution towards the costs of a stay in the Czech Republic of up to CZK 10,000 per month for one to two semesters; the doctoral award covers the basic doctoral-study scholarship plus living costs of up to CZK 16,000 per month for six to twelve months. Both are financed equally from the rectorate's scholarship fund and the relevant faculty's fund, and are awarded under Act No. 111/1998 Sb. on Universities, section 91(3)(b). The award is a living-cost contribution and does not cover tuition fees.",
      "funding_amount": 10000,
      "funding_currency": "CZK",
      "funding_period": "per month",
      "catalogue_url": null,
      "official_updates_url": null,
      "eligibility_summary": "Foreign students taking a Master study programme at CTU, or foreign doctoral students studying on an English-language doctoral programme at CTU in Prague, who are enrolled as foreign students at the relevant faculty and are not already holders of other scholarships or mobility grants.",
      "eligibility": [
        "Master's track: a foreign student who wishes to take a Master study programme at CTU and displays qualities that entitle them to the award",
        "Doctoral track: a foreign doctoral student capable of doing scientific work and studying on a doctoral programme in English language at CTU in Prague",
        "Enrolled as a foreign student at the relevant faculty of CTU",
        "Not eligible: Erasmus students at CTU",
        "Not eligible: Erasmus Mundus students at CTU",
        "Not eligible: Exchange students at CTU",
        "Not eligible: CTU foreign students receiving a government scholarship",
        "Not eligible: other scholarship holders",
        "Master's track: must have the agreement of their faculty before applying"
      ],
      "coverage": [
        "Master's track: contribution towards the costs of a stay in the Czech Republic up to CZK 10,000 per month",
        "Doctoral track: the basic scholarship for doctoral study programmes plus living costs up to CZK 16,000 per month"
      ],
      "benefits": [
