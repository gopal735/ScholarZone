            },
            {
              "trigger": "Mid-July 2027",
              "message": "Winners are informed by mid-July, after the JJ/WBG Steering Committee approval."
            }
          ],
          "submission_workflow": [
            "1. Verify eligibility: Japanese nationality; bachelor's or equivalent earned at least three years before the Application Deadline; at least 3 years of paid development-related employment acquired since the degree and within the past six years from the deadline; unconditional admission (except for financing) or current full-time enrolment in a development-related graduate programme outside Japan, or current full-time development-related employment pertaining directly to developing countries.",
            "2. Confirm you hold no Government of Japan or related agency employment - JICA, local governments, the Central Bank - and no World Bank Group role or close-relative relationship, on or after the relevant opening dates.",
            "3. Read the 2027 Application Guidelines for Japanese Nationals and the 2027 FAQ.",
            "4. From 15 February 2027, email the JJ/WBGSP Secretariat at scholarshipapplicants@worldbank.org to express your interest.",
            "5. Complete and submit the scholarship application before 16 April 2027.",
            "6. If notified as a semi-finalist or awardee, inform and document any other sources of scholarship funds to the Secretariat.",
            "7. Await the two-assessor review, the Secretariat's selection and the JJ/WBG Steering Committee approval; winners are informed by mid-July."
          ],
          "post_award_requirements": [
            "Study the development-related graduate programme outside Japan for the duration of the programme or two years, whichever is less.",
            "Advance your professional career after the degree with a keen focus on the alleviation of poverty and enhanced shared prosperity in developing countries, as the programme expects.",
            "Complete all requirements to earn the graduate degree by the end of the scholarship period if you want the funded return flight.",
            "Receive the monthly subsistence allowance only while on campus, and budget for time away from campus separately.",
            "Do not accept funding that would duplicate rather than supplement this scholarship, and disclose and document any other scholarship funds to the Secretariat as required.",
            "Cover personally all costs the scholarship excludes, including visa application costs, family expenses, extra-curricular courses and training, additional travel, research and supplementary educational expenses, field trips, workshops, seminars, internships, computers, non-provided language training, courses below the minimum credit requirement, and the resident permit fee."
          ],
          "questions_to_ask_host": [
            "Does my programme's award sit inside the two-year cap, and does it count as the full duration of the programme for funding purposes?",
            "Is the scholarship period measured from my enrolment date, and does an academic leave or a research trip outside the host country reduce it?",
            "What is the host country's monthly subsistence allowance, and is the allowance affected by time spent off campus?",
            "What is the deadline for completing all degree requirements, given that the funded return flight depends on it?",
            "What is the process for basic medical insurance through the university, and when is it deducted from the award?",
            "What are the institution's expectations for a mid-career visiting researcher, and are there additional costs the institution expects scholars to cover?",
            "What is the resident permit fee at this host, given that the scholarship does not cover it?"
          ]
        },
        "verification": {
          "cycle_verified": "2027 cycle verified on 2026-10-01: the 2027 application window for Japanese nationals will open from 15 February to 16 April 2027, and from 15 February 2027 candidates are invited to express their interest to the Secretariat by email. Both dates fall after the verification date, so the record is UPCOMING. The page also records that the 2026 application window for Japanese nationals closed on Friday 17 April 2026.",
          "verification_confidence": 0.89,
          "official_fields_confirmed": [
            "Purpose: scholarships for up to two years to a limited number of Japanese mid-career professionals dedicated to alleviating poverty and enhancing shared prosperity in developing countries, who are admitted to or currently enrolled in a master's or PhD programme outside Japan in development-related fields",
            "Post-award expectation: after earning their degree, Japanese national scholars are expected to advance their professional career with a keen focus on the alleviation of poverty and enhanced shared prosperity in developing countries",
            "2027 window: opens 15 February 2027, closes 16 April 2027, with interest expressions invited to scholarshipapplicants@worldbank.org from 15 February 2027",
            "Funding source: the scholarship is fully funded by the Government of Japan",
            "Benefits: one economy class flight from home country to host university at the start of the programme, if not already attending, plus a $600 travel allowance; one economy class flight from host university to Japan or a developing country where the scholar has secured employment, if all degree requirements are completed by the end of the scholarship period, plus a $600 travel allowance; tuition for the duration; the cost of basic medical insurance obtainable through the university; and a monthly subsistence allowance for all living expenses including accommodation, food and books while on campus, with the amount varying by host country",
            "Duration: the duration of the graduate program or two years, whichever is less",
            "Full non-covered list: visa application costs; family member expenses; extra-curricular courses or training; courses not meeting the minimum credits to earn the degree; language training not provided by the graduate program; additional travel during the study program; research, supplementary educational materials, field trips, workshops, seminars and internships; educational equipment such as computers; the resident permit fee",
            "Supplement-not-duplicate rule, with the requirement to inform and document other sources of scholarship funds if notified as a semi-finalist or awarded",
            "Eligibility: Japanese national; no World Bank Group role and no close-relative relationship by blood or adoption on or after the date the call opens, with the World Bank Group defined as the World Bank, IDA, IFC, MIGA and ICSID and the close relatives enumerated; a bachelor's or equivalent earned at least three years before the Application Deadline; no employment with the Government of Japan or its related agencies including JICA, local governments and the Central Bank on or after the date the process opens; at least 3 years of paid development-related employment acquired since the degree and within the past six years from the Application Deadline; and either unconditional admission (except for financing) or current full-time enrolment in a development-related graduate programme outside Japan, or current full-time development-related employment pertaining directly to developing countries",
            "The statement that detailed eligibility criteria are in each call's Application Guidelines and are strictly adhered to with no exceptions",
            "Selection method: two qualified assessors score 1-10 on Quality of Academic Experience and Recommendation (20%), Quality of Professional Recommendations (20%), Quality of Professional Experience (20%) and Commitment to International Development Career (40%), with the degree of cohesion among the factors taken into account",
            "Secretariat selection criteria: reasonable distribution of awards across gender, and preference for applicants with limited access to financial resources for graduate studies abroad",
            "Final approval by the JJ/WBG Steering Committee, composed of members of the World Bank Board of Directors and World Bank management, with winners informed by mid-July",
            "The 2026 Japanese nationals window closed on Friday 17 April 2026",
            "Published references: 2027 Application Guidelines for Japanese Nationals and 2027 FAQ for Japanese Nationals, both PDFs"
          ],
          "institution_check_required": [
            "2027 Application Guidelines for Japanese Nationals - published only as a PDF, so it could not be read. It holds the detailed eligibility criteria that the World Bank says are strictly adhered to, the document list, and any annexes or form requirements.",
            "2027 FAQ for Japanese Nationals - published only as a PDF, not read, so any clarification on the employment and admission tests is unverified.",
            "The full required-document list and any file type, size, signature, translation or date rules, none of which are published on the page.",
            "The number of referees, their seniority, and the reference format, none of which are published on the page.",
            "The monthly subsistence allowance amount for any specific host country, which the page states varies by host country without publishing figures.",
            "Any list of eligible or participating host programmes for the Japanese nationals window, which the page does not provide.",
            "The number of scholarships available in the 2027 Japanese nationals window; the page refers only to a limited number without a figure.",
            "The precise mechanics of the expression-of-interest step and whether the subsequent application is submitted by email or through a separate system, since the page only names the Secretariat email for expressing interest."
          ],
          "unverified_or_removed_claims": [
            "Rejected 'fully funded' in the sense of covering all scholar costs: the page states the scholarship 'is fully funded by the Government of Japan', which describes the funding source, and then lists a long set of costs it does not cover, including visa fees, family expenses, computers, field trips and the resident permit fee. On the strict test - tuition, living costs and required expenses all established - fully_funded is false, and the funding-source statement is recorded in the purpose and coverage fields instead.",
            "Rejected a single funding_amount: the award has four distinct published components (two flights each with a US$600 allowance, tuition, medical insurance, and a host-country-variable monthly subsistence allowance), so the figures stay in text and funding_amount is null with funding_currency USD confirmed by the dollar travel allowance.",
            "Rejected populating the subsistence figure: the allowance varies by host country and no amount is published, so no amount is recorded for it.",
            "Set student_direct_application to true, on the published basis that from 15 February 2027 prospective candidates express their interest directly to the JJ/WBGSP Secretariat by email and no intermediary nominating body is described for this window - which is a genuine contrast with the developing country nationals window, where only National Commission-nominated applications are accepted.",
            "Set return_home_required to null: the page states an expectation of advancing a career focused on developing countries, and funds a return flight to Japan or a developing country, but it does not impose a return-home obligation as a condition.",
            "Set deferrable and renewable to null: the page publishes an up-to-two-year cap and no extension or renewal provision.",
            "Left host_institution_fee and tax_status null: neither is mentioned on the page.",
            "Did not read or quote from the Japanese nationals Application Guidelines or FAQ PDFs, and did not use them to fill any field, in line with the constraint that PDF documents must be recorded for institutional checking rather than quoted.",
            "Did not import the two-window structure, the 44 participating programmes, the eligible-country list or the developing country nationals scoring weights, which belong to the separate developing country nationals window."
          ],
          "source_conflict_rule": "The Japanese nationals page governs this window's purpose, dates, benefits, exclusions, eligibility and selection method. The 2027 Application Guidelines for Japanese Nationals govern the detailed eligibility criteria, which the page states are strictly adhered to with no exceptions, and the FAQ governs any clarification of the employment and admission tests. The JJ/WBGSP main page is used only for the cross-reference fact that the 2026 Japanese nationals window closed on 17 April 2026, and its developing-country-nationals content is not imported into this record.",
          "source_freshness_rule": "The page publishes explicit 2027 window dates and a notice that the dates have been announced, so the window is re-checked at each verification and the page's dates compared against the previous reading. The Application Guidelines and FAQ are versioned per year and must be re-read each cycle, because the page states the detailed criteria change between calls and are strictly enforced. The two eligibility tests that hinge on relative dates - the three-year degree timing and the six-year employment window - are re-derived from the current Application Deadline on each cycle.",
          "source_citations": [
            "https://www.worldbank.org/en/programs/scholarships/japanese-nationals",
            "https://www.worldbank.org/en/programs/scholarships/jj-wbgsp"
          ],
          "researched_by": "f2",
          "last_verified_date": "2026-10-01",
          "data_quality": {
            "source_level": "Official provider page (World Bank, worldbank.org)",
            "coverage": "High for programme purpose, 2027 window dates, benefits, non-covered costs, eligibility in brief, exclusions, selection method and weighting, and the interest-expression contact, all published on the page; Low for detailed eligibility, document requirements, reference requirements and per-country figures, which sit in PDFs and are not published on the page.",
            "pages_read": [
              "https://www.worldbank.org/en/programs/scholarships/japanese-nationals",
              "https://www.worldbank.org/en/programs/scholarships/jj-wbgsp"
            ],
            "pages_unreadable": [
              "2027-Application-Guidelines-for-Japanese-Nationals.pdf and 2027-FAQ-for-Japanese-Nationals.pdf - published as downloads; PDF text cannot be extracted, so the detailed eligibility criteria, document list and clarifications are unverified"
            ]
          }
        }
      },
