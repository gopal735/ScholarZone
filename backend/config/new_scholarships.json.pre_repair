          ],
          "application_link": "https://frqnet.frq.gouv.qc.ca/",
          "official_updates_url": "https://frq.gouv.qc.ca/en/open-competitions/",
          "catalogue_url": "https://frq.gouv.qc.ca/en/complete-program-directory/",
          "application_cycle": "2026-2027 fiscal year competition, now out of competition; results announced April 2026. Annual programme; next cycle date not published as at 2026-10-04.",
          "deadline_central": "2025-12-02T16:00",
          "deadline_central_display": "Deadline (application): December 2nd, 2025 at 16:00 (EST). Institution preselection of applications to FRQ: October 23, 2025, 4 p.m. China Scholarship Council preselection: before March 31, 2026.",
          "deadline_central_timezone": "America/Toronto",
