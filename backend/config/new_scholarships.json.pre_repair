      "last_verified_date": "2026-10-04",
      "region": "Oceania",
      "duration": "Payments made for 3.5 years (PhD candidates) or 1.5 years (MPhil candidates)",
      "program_type": "Academic merit - centrally managed scholarship round",
      "description": "The ANU University Research Scholarship supports high-achieving higher degree by research (HDR) students whose research aligns with the strategic directions of the Australian National University. It is awarded through ANU's two annual central scholarship rounds alongside the Research Training Program and other centrally managed scholarships, and no separate application is required: prospective candidates are considered automatically on the basis of their admission application. The value is a fortnightly stipend of $40,475 per annum (2027 full-time base rate), paid for 3.5 years for PhD candidates or 1.5 years for MPhil candidates. Each ANU College convenes a selection committee to score and rank all eligible H1 (or equivalent) applicants on academic record, research potential, supervisor support, referee reports and English language competency.",
      "deadline": "Round 1 (commencement by end of March the following year): International application deadline 31 August; Domestic application deadline 31 October. Round 2: commencement by end of August the same year. No separate application is required.",
      "deadline_date": null,
      "deadline_precision": "recurring",
      "application_period": "ANU states the application period is open all year round, with consideration organised into two annual central rounds. Round 1 international applications close 31 August and domestic applications 31 October for commencement by the end of March the following year; Round 2 is for commencement by the end of August the same year.",
      "eligibility_summary": "Available each year to a prospective or continuing student who is a domestic or international student enrolled in an accredited HDR course of study at ANU, has achieved a minimum of Honours (H1) or H1 equivalent in their prior studies, and is not an Industry PhD Candidate receiving a full-time salary. Selection requires each ANU College to convene a selection committee to score and rank all eligible H1 (or equivalent) applicants in a merit-based process.",
      "eligibility": [
        "Be a domestic student or an international student enrolled in an accredited HDR course of study at ANU",
        "Have achieved a minimum of Honours (H1) or H1 equivalent in their prior studies",
        "Not be an Industry PhD Candidate receiving a full-time salary"
      ],
      "coverage": [
        "Fortnightly stipend of $40,475 per annum (2027 full-time base stipend rate)",
        "Travel and removal allowances for students relocating to Canberra",
        "Thesis allowance",
        "Dependant Child allowance (international students only)",
        "Paid medical, maternity and parental leave"
      ],
      "benefits": [
        "Fortnightly stipend at $40,475 per annum (full-time base stipend rate 2027)",
        "Payments for 3.5 years (PhD) or 1.5 years (MPhil)",
        "Travel and removal allowances for students relocating to Canberra to commence their research program",
        "Thesis allowance",
        "Dependant Child allowance for international students only",
        "Paid medical, maternity and parental leave"
