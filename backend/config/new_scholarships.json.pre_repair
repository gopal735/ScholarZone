    {
      "name": "Embassy Science Fellowship (ESF-NL) 2027",
      "legacy_titles": [
        "NWO Embassy Science Fellowship (ESF-NL) 2027"
      ],
      "country": "Netherlands",
      "degree_levels": "PhD and above",
      "funding_type": "Research fellowship",
      "official_source": "Dutch Research Council (NWO) and Ministry of Foreign Affairs",
