            "https://www.vlaanderen.be/en/studying/flanders-trainee-programme/flanders-trainee-programme-amounts",
            "https://www.vlaanderen.be/en/studying/flanders-trainee-programme/flanders-trainee-programme-application-and-procedure",
            "https://www.vlaanderen.be/en/studying/flanders-trainee-programme/flanders-trainee-programme-internships"
          ],
