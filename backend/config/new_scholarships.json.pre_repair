    {
      "name": "ARES Scholarships - Bourses de formations internationales (scholarships for study in Belgium)",
      "legacy_titles": [
        "ARES Scholarships (Belgium)"
      ],
      "country": "Belgium",
      "degree_levels": "Bachelor's, Master's, Short courses",
      "funding_type": "Partially Funded",
      "official_source": "ARES (Fédération Wallonie-Bruxelles, Belgium)",
      "official_source_url": "https://ares-ac.be",
      "status": "upcoming",
      "is_verified": false,
      "last_verified_date": "2026-10-04",
      "region": "Europe",
      "description": "ARES, the Walloon agency for international cooperation and education, awards scholarships so that professionals from its partner countries can study in Wallonia, in institutions of the Fédération Wallonie-Bruxelles. The 'bourses de formations internationales' cover a one-year bachelor of specialisation (bachelier de spécialisation), a specialised master's degree (master de spécialisation) or a short continuing-education course of up to six months, with study programmes that address development-related issues. The scholarship is aimed at people who are permanent residents and working in one of ARES's partner countries and who already hold a higher education diploma. For the 2026-2027 call 200 scholarships were available; for 2027-2028 the call offered one bachelor of specialisation, eight specialised master's degrees and one continuing-education certificate. Applications are submitted through the GIRAF platform and the selection is run by a jury for each programme.",
      "deadline": "For the 2027-2028 call, applications had to be submitted through the GIRAF platform by Friday 18 September 2026 at 12h (Belgian time). The call is now closed and the next call is announced for August 2027.",
      "deadline_date": null,
      "deadline_precision": "recurring",
      "application_period": "Annual cycle: the call opens in early August and applications close in mid-September, with preselection and selection running from October to May and results in June",
      "catalogue_url": "https://www.ares-ac.be/fr/bourses",
      "official_updates_url": "https://www.ares-ac.be/fr/bourses",
      "program_type": "Government scholarship of the Walloon government, administered by ARES",
      "notes": "Applying to an ARES scholarship is free of charge: \"Postuler à une bourse de l'ARES est gratuit. L'ARES ne demande donc aucun frais à quelque étape du processus de candidature ou de sélection que ce soit.\" ARES warns against anyone claiming to act for ARES and requesting payment by email; report such cases to bourses-cooperation@ares-ac.be. Award holders are expected to return to their country of origin or another country and to apply the training acquired in Belgium to development, for example through a work contract or a formal commitment, with a multiplier effect. ARES guarantees the possibility of deferring the scholarship in case of pregnancy.",
      "detail": {
        "official_details": {
          "official_source_urls": [
            "https://ares-ac.be",
            "https://www.ares-ac.be/fr/bourses-de-formations-internationales-2027-2028",
            "https://www.ares-ac.be/fr/bourses",
            "https://www.ares-ac.be/sites/default/files/2025-08/ares-document-reference-formations-internationales-2026-2027.pdf"
          ],
          "application_link": null,
          "official_updates_url": "https://www.ares-ac.be/fr/bourses",
          "catalogue_url": "https://www.ares-ac.be/fr/bourses",
          "application_cycle": "2027-2028 cycle closed on 18 September 2026 at 12h (Belgian time); the next call is announced for August 2027 for the following academic year",
          "deadline_central": null,
          "deadline_central_display": "\"Vendredi 18 septembre 2026\" for the 2027-2028 call, submitted through the GIRAF platform at 12h Belgian time",
          "deadline_central_timezone": "Europe/Brussels",
          "deadline_note": "The 2027-2028 deadline of 18 September 2026 has passed. The call follows a fixed annual rhythm: the call opens in the first days of August, the deadline for creating or validating a GIRAF account falls in early September at 16h Belgian time, the application deadline is 18 September at 12h Belgian time, the selection process runs from October to May, and results are announced in June. Because the next call is not open yet, no exact deadline date is reported.",
          "status": "UPCOMING",
          "status_note": "The 2027-2028 call is closed: the ARES page states \"L'appel bourses 2027-2028 est clôturé. Prochain appel : Août 2027.\"",
          "funding_amount": null,
          "funding_currency": null,
          "funding_period": null,
          "funding_duration": "Bachelor and specialised master's: 12 months maximum; continuing education: 6 months maximum",
          "tuition_coverage": true,
          "tuition_coverage_note": "The call lists among the components of the scholarship: \"Frais d'inscription (uniquement pour les bacheliers et les masters de spécialisation)\", that is registration fees for the bachelor and specialised master's scholarships.",
          "living_cost_coverage": true,
          "travel_coverage": true,
          "fully_funded": false,
          "funding_label": "The scholarship comprises international travel costs, a subsistence allowance, exceptional visa costs (bachelor and specialised master's only), registration fees (bachelor and specialised master's only), indirect mission costs (continuing education only) and insurance. No single monetary amount is published on the call page, so fully_funded is not claimed.",
          "benefits": [
            "International travel costs",
            "Subsistence allowance",
            "Exceptional visa-related costs for the bachelor and specialised master's scholarships",
            "Registration fees for the bachelor and specialised master's scholarships",
            "Indirect mission costs for continuing-education courses",
            "Insurance"
          ],
          "eligibility": [
            "Be a permanent resident of and work in one of the ARES partner countries (32 for the 2027-2028 call); nationals of Palestine are eligible even if not resident in one of those countries",
            "Hold a higher education diploma matching the admission conditions of the chosen programme, obtained at most 20 years before the start of the training (extended by one year per birth and/or adoption)",
            "Have at least two years of relevant professional employment in a partner country after the last higher education diploma",
            "Complete the application in the language in which the programme is taught and attest to a good written and spoken command of that language",
            "Have at least some French, which helps with daily life in Belgium",
            "Apply to a single programme only"
