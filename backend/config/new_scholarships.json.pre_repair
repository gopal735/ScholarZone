    {
      "name": "Mauritius-Africa Scholarship Scheme (MASS)",
      "country": "Mauritius",
      "region": "Africa",
      "degree_levels": "Undergraduate Diploma, Bachelor's, MPhil, PhD",
      "funding_type": "Partially Funded",
      "program_type": "Government scholarship",
      "official_source": "Ministry of Tertiary Education, Science and Research, Republic of Mauritius",
      "official_source_url": "https://tertiaryeducation.govmu.org/te/wp-content/uploads/2025/10/Call-for-Application.pdf",
      "catalogue_url": "https://tertiaryeducation.govmu.org/te/index.php/mass/",
      "official_updates_url": "https://tertiaryeducation.govmu.org/te/index.php/mass/",
      "status": "upcoming",
      "is_verified": true,
      "last_verified_date": "2026-10-04",
      "description": "The Mauritius-Africa Scholarship Scheme is the Government of Mauritius scholarship for African students, run by the Ministry of Tertiary Education, Science and Research and open to resident citizens of African Union member states and African Commonwealth countries. The 2026 edition funds Diploma, Bachelor's, MPhil and PhD study at public higher education institutions in Mauritius, paying tuition and course-related costs up to a published cap, a monthly living allowance of MUR 16,500 and a return airfare, while requiring awardees to have already secured or applied for a place at a listed Mauritian public institution. Applications are routed through a nominating agency in the applicant's own country, so the Ministry does not accept direct applications.",
      "duration": "Diploma up to three years, Bachelor's up to four years, MPhil up to two years plus six months for thesis defence, MPhil/PhD up to three years plus six months for the transfer report plus one year plus six months for the thesis defence, PhD up to three years plus six months",
      "deadline": "No central date is published: each nominating agency sets its own deadline and communicates it to prospective applicants. For the 2026 edition the Mauritian public universities opened their own application windows from October 2025 and closed them between February and March 2026, so the next edition is expected to follow the same annual cycle.",
      "deadline_date": null,
      "deadline_precision": "recurring",
      "application_period": "Annual edition published by the Ministry, with applications made through the nominating agency in the applicant's country and in parallel with the chosen Mauritian public university's admission window",
      "eligibility_summary": "Resident citizens of African Union member states or African Commonwealth countries aged between 18 and 26 for undergraduate programmes or under 40 for MPhil and PhD programmes by 1 January of the intake year, with a qualifying secondary or undergraduate result of about 60% or 12/20 or the equivalent, and holding or applying for a place at a listed Mauritian public higher education institution.",
      "eligibility": [
        "Be a resident citizen of an African Union member state or an African Commonwealth country",
        "For undergraduate programmes, be above 18 and not yet 26 on 1 January of the intake year",
        "For MPhil, MPhil/PhD and PhD programmes, not yet 40 on 1 January of the intake year",
        "Have already applied for a full-time on-campus Diploma, Degree, MPhil or PhD programme at a listed public higher education institution in Mauritius for the intake year",
        "Hold a qualifying examination result with an overall average of about 60% or 12/20, or the A-level equivalent, or an equivalent qualification",
        "Provide TOEFL 550 (paper), 213 (computer) or 79 (internet), or IELTS 5.5, where the language of instruction in the qualifying examination was not English",
        "Not already hold an undergraduate degree when applying for an undergraduate programme",
        "Not be a self-financing African student already studying in Mauritius applying for the same programme level"
      ],
      "coverage": [
        "Tuition fees and course-related costs up to a published annual cap",
        "Monthly living allowance of MUR 16,500",
        "Return airfare by the most economical route to and from Mauritius",
        "Student visa processing through the host institution and the Passport and Immigration Office"
      ],
      "benefits": [
        "Annual payment of fees and study-related costs up to MUR 100,000 for beneficiaries from SADC countries and MUR 160,000 for beneficiaries from non-SADC countries",
        "Monthly living allowance of MUR 16,500 credited monthly against evidence of attendance from the institution",
        "Return airfare from the country of origin to Mauritius and back after successful completion of the scholarship period",
        "Student visa and provisional entry permit arranged by the host institution",
        "Refunded university application fee for successful applicants"
      ],
      "requirements": [
        "Submit the application through the nominating agency in your own country; applications not processed through a nominating agency are not considered",
        "Obtain either a conditional offer from your chosen Mauritian public institution or proof of having paid its application fee",
        "Produce original educational certificates in Mauritius within two weeks of arrival",
        "Undergo a medical check-up in a Mauritian public hospital within one month of arrival",
        "Not interrupt studies to take up employment, which terminates the award and requires refund of the whole amount paid",
        "Inform the institution and the Ministry at least two weeks before any travel out of Mauritius",
        "Ensure the host institution submits quarterly attendance and progress reports to support continued disbursement"
      ],
      "required_documents": [
        "Completed Mauritius-Africa Scholarship Application Form",
        "Certified copy of birth certificate",
        "Certified copy of the biodata page of the passport",
        "Certified copies of educational certificates",
        "Certified copies of transcripts",
        "Conditional offer letter from a public higher education institution in Mauritius, or its application fee receipt",
        "Medical certificate completed and stamped by a registered medical practitioner"
      ],
      "application_method": [
        "Apply to a listed Mauritian public higher education institution in parallel, through its own admission window",
        "Complete the Mauritius-Africa Scholarship Application Form",
        "Submit the form with all checklist documents to the nominating agency in your country of origin by that agency's deadline",
        "The nominating agency endorses and transmits the application to the Ministry",
        "After award, the host institution applies for the student visa and provisional entry permit",
        "On arrival, produce original certificates, undergo the medical check-up and open a Mauritian bank account for the allowance"
