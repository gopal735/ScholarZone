      "name": "ACIAR Pacific Agriculture Scholarships and Support Program (PASS)",
      "country": "Fiji",
      "region": "Australia",
      "degree_levels": "Master's, PhD",
      "funding_type": "Fully Funded",
      "program_type": "Government scholarship",
      "official_source": "Australian Centre for International Agricultural Research (ACIAR)",
      "official_source_url": "https://www.aciar.gov.au/scholarships/pass",
      "catalogue_url": "https://www.aciar.gov.au/scholarships",
      "official_updates_url": "https://www.aciar.gov.au/scholarships/pass",
      "status": "open",
      "is_verified": true,
      "last_verified_date": "2026-10-04",
      "description": "The Pacific Agriculture Scholarships and Support (PASS) Program funds postgraduate research scholarships in agriculture, forestry and fisheries at the University of the South Pacific (USP) and Fiji National University (FNU). It is an Australian Government programme delivered by ACIAR, an Australian Government statutory authority, and is described by ACIAR as part of the Australian Government's support to Pacific neighbours. Scholarships are for Pacific Islander nationals and are awarded for up to two years at Master's level and up to three years for PhD candidates, with study available from Semester 1 2027.",
      "duration": "Up to 2 years for Master's students; 3 years (or over, if applicable) for PhD candidates",
      "deadline": "21 October 2026",
      "deadline_date": "2026-10-21",
      "deadline_precision": "exact",
      "application_period": "2027 intake: applications open 20 August 2026 and close 21 October 2026, for scholarships available from Semester 1 2027. ACIAR states scholarships are advertised annually through USP and FNU for commencement the following year.",
      "eligibility_summary": "Pacific Island country nationals who are citizens of and currently reside in Fiji, Kiribati, Samoa, Solomon Islands, Tonga, Tuvalu or Vanuatu (USP also lists the 12 USP member countries), who meet USP or FNU postgraduate entry requirements and can satisfy mandated travel requirements to Fiji or Samoa.",
      "eligibility": [
        "Be a citizen of and currently reside in Fiji, Kiribati, Samoa, Solomon Islands, Tonga, Tuvalu or Vanuatu",
        "Meet the eligibility criteria for postgraduate study at USP or FNU",
