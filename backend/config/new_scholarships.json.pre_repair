        "applicant_utility": {
          "application_readiness_checklist": [
            "Contact the International Relations Office of your home institution early - participant deadlines are set by the institution, not by SERI or Movetia",
            "Confirm your home institution is SEMP-accredited (SEMP Charter or ECHE)",
            "Check that your desired host institution is a partner of your home institution under an interinstitutional agreement",
            "Confirm the destination is fundable: some institutions only award SEMP grants for mobilities within Europe",
            "Choose a stay between 60 days and 12 months and agree the study plan so credits count towards your degree",
            "Prepare the learning agreement (or mobility/grant agreement for staff) and the Declaration of Honour",
            "If you have a disability or a physical, mental or chronic illness, apply for the special-needs grant via the International Relations Office at least two months before departure",
            "Travel sustainably where possible: the CHF 100 top-up is only paid for train, bus or car sharing",
            "Budget beyond the grant, which is calibrated per mobility rather than to a full living budget"
          ],
          "common_rejection_risks": [
            "No interinstitutional agreement with the host institution",
            "Missing the home institution's own participant deadline",
            "Host destination outside the institution's partner network",
            "Stay shorter than 60 days or longer than 12 months",
            "Courses at the host that do not count towards the home degree",
            "Applying to Movetia directly instead of through the home institution",
            "Missing the special-needs grant deadline (it must be applied for before departure)",
            "Failing to submit the Declaration of Honour or validated learning agreement"
          ],
          "estimated_uncovered_costs": [
            "The grant is a flat mobility amount, not a living-cost stipend: it is calibrated by duration (CHF 1,430 to CHF 3,900 for European mobility outgoing, CHF 1,750 to CHF 5,000 worldwide), so remaining living costs must be budgeted",
            "Fees at the home institution abroad are not charged, but any host-country costs outside the grant (for example local field trips, materials) are not mentioned as covered",
            "Special-needs support is capped at CHF 12,000 and reimbursed against actual costs evidenced in the requirement note"
          ],
          "document_audit": [
            "Learning agreement validated by sending institution, receiving institution and participant",
            "Declaration of Honour for student mobility, finalised by the Swiss institution before the mobility period",
            "Mobility agreement or Grant Agreement for staff mobility",
            "Interinstitutional agreement reference",
            "Requirement note (Anforderungsprotokoll) for any special-needs grant",
            "Certified translations of documents, with self-certification accepted for India",
            "Evidence of the home institution's SEMP accreditation"
          ],
