    {
      "name": "Tulī Takes Flight Scholarships",
      "legacy_titles": [
        "Tulī Takes Flight Scholarships 2026"
      ],
      "country": "New Zealand",
      "degree_levels": "Vocational, Undergraduate, Postgraduate",
      "funding_type": "Partially Funded",
      "official_source": "New Zealand Ministry of Education",
      "official_source_url": "https://www.education.govt.nz/news/applications-open-2026-tuli-takes-flight-and-pacific-education-foundation-scholarships",
      "status": "upcoming",
      "is_verified": true,
      "last_verified_date": "2026-10-04",
      "description": "Tulī Takes Flight scholarships are funded by the New Zealand Ministry of Education and administered by the Pacific Education Foundation to reduce financial barriers to tertiary study and vocational training for Pacific people. They form part of the government's gesture of goodwill and reconciliation to Aotearoa Pacific communities following its 2021 apology for the Dawn Raids. Awards can be made for either vocational or academic study and can run for one, two or three years. For the 2027 round the Ministry states applications are closed and outcomes will be notified by 18 March 2027; a new annual round is expected to open in the same late-summer window each year.",
      "region": "Oceania",
      "duration": "1, 2 or 3 years per award",
