            },
            {
              "trigger": "Limited places",
              "message": "Only 100 international scholarships are available, with two full and ten half waivers per country, so competition is high."
            }
          ],
          "submission_workflow": [
            "Visit the KIIT International Admissions Portal at international.kiit.ac.in and register an account",
            "Verify your email address using the confirmation link",
            "Select the undergraduate, postgraduate or PhD programme and confirm it is KUISP-eligible",
            "Complete personal, address and educational qualification details",
            "Upload your photograph, passport copy, transcripts, certificates and any English translations",
            "Submit the scholarship application, which is free of charge, and save your confirmation",
            "If applying through an Indian embassy or mission, obtain the mission's recommendation as well",
            "On acceptance, confirm acceptance, complete enrolment, obtain the bonafide from IR Admissions and apply for a student visa",
            "Arrange accommodation and food payments and all excluded costs before arrival"
