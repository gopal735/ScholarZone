    {
      "name": "Scholarships and Educational Exchanges for Development - Phase 2 (SEED-2)",
      "legacy_titles": [
        "Canada-ASEAN Scholarships and Educational Exchanges for Development (SEED-2)"
      ],
      "country": "Canada",
      "region": "Canada (host); ASEAN Member States, Pacific Island Countries and Mongolia (applicant origin)",
