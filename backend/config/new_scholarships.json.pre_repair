          "eligibility": [
            "Complete deposit of the submission file on the ANR submission site before the closing date and time, including the administrative and financial document signed and stamped by each partner institution",
            "Scientific document following the published template, in unprotected PDF",
            "Project duration between 36 and 54 months",
            "Aid requested between 0.8 M€ and 3 M€",
            "Coordinating institution a French higher education and research institution",
