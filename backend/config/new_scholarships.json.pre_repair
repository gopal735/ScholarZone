    {
      "name": "Mannagetta Fellowships (Johann Wilhelm Ritter von Mannagetta Foundation at the Austrian Academy of Sciences)",
      "legacy_titles": [
        "Johann Wilhelm Ritter von Mannagetta Foundation Fellowships"
      ],
      "country": "Austria",
      "region": "Europe",
      "degree_levels": "PhD",
