      "name": "Beca Doctoral PUCP - Programa de Apoyo a la Investigación Doctoral",
      "country": "Peru",
      "region": "Latin America",
      "degree_levels": "PhD",
      "funding_type": "Fully Funded",
      "program_type": "Doctoral scholarship",
      "official_source": "Pontificia Universidad Católica del Perú (PUCP) - Vicerrectorado de Investigación and Escuela de Posgrado",
      "official_source_url": "https://posgrado.pucp.edu.pe/becas/becas-doctoral-pucp/",
      "catalogue_url": "https://posgrado.pucp.edu.pe/becas/",
