          "general_eligibility": [
            "Beneficiaries are research organisations and higher education and research institutions.",
            "Private institutions contributing to public-service missions in higher education and research under article L.732-1 of the Code de l'Education may be financed after ANR analysis, MESRE opinion and SGPI validation.",
            "Companies and foreign institutions may be associated as partners without receiving funding.",
            "The submitted teams must reflect the interdisciplinary and/or transdisciplinary ambition of the projects."
          ],
          "ineligibility_conditions": [
            "A file not deposited complete before the closing date and time, or with the signed partner documents missing or late, is not admissible.",
            "A scientific document not following the published template or deposited in a protected PDF.",
