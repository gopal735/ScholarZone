    {
      "name": "FWF ESPRIT (Early-Stage Program: Research - Innovation - Training)",
      "legacy_titles": [
        "FWF ESPRIT Career Program"
      ],
      "country": "Austria",
      "region": "Europe",
      "degree_levels": "Postdoc",
      "funding_type": "Fully Funded",
      "official_source": "Austrian Science Fund (FWF)",
      "official_source_url": "https://www.fwf.ac.at/en/funding/funding-portfolio/fwf-espriT",
      "status": "open",
      "is_verified": true,
      "last_verified_date": "2026-10-04",
      "description": "ESPRIT (Early-Stage Program: Research - Innovation - Training) is an Austrian Science Fund career programme that lets highly qualified postdoc-level researchers lead an independent research project at an Austrian research institution. The FWF states a funding period of 36 months, paying the principal investigator's salary at the current senior postdoc rate plus project-specific costs of EUR 45,000 as a flat rate, or up to EUR 75,000 with justification. Submissions are accepted on a rolling basis through the elane online application portal, and decisions are taken at five Scientific Board approval meetings per year.",
      "funding_amount": null,
      "funding_currency": "EUR",
      "funding_period": "over 36 months",
      "deadline": "\"Rolling submissions using the online application portal elane\"",
      "deadline_date": null,
      "deadline_precision": "rolling",
      "application_period": "Rolling; applications can be submitted at any time via the elane portal, with five FWF approval meetings per year",
      "duration": "36 months",
      "program_type": "Career development grant for early-career postdocs (principal investigator project)",
      "eligibility_summary": "Highly qualified postdoc-level researchers of all disciplines at an early stage of their scientific career, with a doctoral degree awarded no more than 5 years before application, an Austrian mentor, and a host Austrian research institution.",
      "eligibility": [
        "Academic qualifications needed to lead the proposed research project",
        "Completed doctoral degree awarded no more than 5 years prior to the time of application",
        "A mentor to support the principal investigator's scientific and professional development",
        "Project to be carried out at an Austrian research institution with the necessary infrastructure",
        "Application submitted with an Austrian research institution (PROFI mode)"
      ],
      "coverage": [
        "Principal investigator's salary at the current senior postdoc rate for a 36-month employment",
        "Project-specific costs of EUR 45,000 as a flat rate, or up to EUR 75,000 with justification"
      ],
      "benefits": [
        "Full-time employment of the principal investigator at the host Austrian research institution for 36 months",
        "Project-specific cost lump sum of EUR 45,000, extendable to up to EUR 75,000 on justified request",
        "Mentored career development with an assigned mentor",
        "Child allowance for women employed full time, up to the child's third birthday",
        "Networking activities, annual workshops and visibility measures for women in ESPRIT projects"
      ],
      "required_documents": [
        "Project description and annexes uploaded in full in elane",
        "Professional development and mentoring plan",
        "Support declaration from the mentor (Unterstuetzungserklaerung Mentor:in), for approved projects",
        "Template publication record of the principal investigator",
        "Scientific disciplines / Code Statistics Austria classification document",
        "Checklist ESPRIT",
        "Information on and form for accounting for career breaks, if applicable"
      ],
      "requirements": [
        "Applications are administered in PROFI mode: after logging in to elane select \"Application PROFI\", then the funding category \"ESP - ESPRIT Program\"",
        "A mentor and an appropriate professional development and mentoring plan are mandatory",
        "No parallel application to ESPRIT, Erwin Schrödinger, Elise Richter or Elise Richter PEEK while an ESPRIT application is pending",
        "The territoriality principle does not apply to ESPRIT, so applications may be submitted from abroad, but an Austrian mentor and an Austrian host institution are still required"
      ],
      "application_method": [
        "Online application through the elane digital application portal, in PROFI mode"
      ],
      "catalogue_url": "https://www.fwf.ac.at/fileadmin/Website/Dokumente/Foerdern/Portfolio/ESPRIT/fwf_esp_application_guidelines.pdf",
      "official_updates_url": null,
      "english_requirement": "The official programme page and application guidelines are published in English; no English language test for applicants is stated",
      "selection_notes": "Decision by the FWF Scientific Board based on an international review process. In the case of equal qualifications and equal quality of proposals, women are given priority in the selection process. Five approval meetings are held per year.",
      "best_fit": "Postdocs within five years of completing their doctorate, from any discipline including arts-based research, who can secure an Austrian host research institution and an Austrian mentor.",
      "notes": "The FWF aims to award at least half of ESPRIT projects to female principal investigators. Researchers who will complete their doctorate within the roughly 4 to 6 month processing time may apply, but cannot start the project before submitting their doctoral degree certificate.",
      "detail": {
        "official_details": {
