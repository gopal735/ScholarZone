      "status": "open",
      "is_verified": true,
      "last_verified_date": "2026-10-04",
      "description": "The Mannagetta Fellowships are financed from the funds of the Johann Wilhelm Ritter von Mannagetta Foundation held at the Austrian Academy of Sciences and support doctoral candidates at Austrian universities in completing a doctoral thesis in the humanities, cultural and social sciences. Applicants must have started their doctoral studies at a university in Austria no more than three years before the submission deadline and need no more than another twelve months to finish. Each fellowship is worth EUR 25,000 for twelve months, and one or two fellowships are granted per year. Applications for the next round close on 20 October 2026 at 2 p.m. CEST.",
      "funding_amount": 25000,
      "funding_currency": "EUR",
      "funding_period": "one award of 12 months",
      "deadline": "\"Submission deadline 20 October 2026 (2 p.m. CEST)\"",
      "deadline_date": "2026-10-20",
      "deadline_precision": "exact",
      "application_period": "Applications for the 2026 round close on 20 October 2026 at 14:00 CEST; the fellowship is awarded once or twice per year.",
      "duration": "12 months",
      "program_type": "Completion fellowship for doctoral candidates in the humanities, social sciences, law and arts disciplines",
      "eligibility_summary": "Young, highly qualified doctoral candidates enrolled at a university in Austria who started their doctoral studies no more than three years before the submission deadline and expect to need no more than a further twelve months to complete the thesis.",
      "eligibility": [
        "Young, highly qualified doctoral candidates pursuing doctoral studies at a university in Austria",
        "Doctoral or PhD studies started no more than three years before the submission deadline",
        "Expected to need no more than another twelve months to complete the doctoral thesis",
        "Dissertation project in one of the listed subject areas"
      ],
      "coverage": [
        "Cash stipend of EUR 25,000 intended to contribute to covering living expenses",
        "No travel or printing allowances: the statutes state these cannot be applied for"
      ],
      "benefits": [
        "EUR 25,000 stipend for a twelve-month fellowship period"
      ],
      "required_documents": [
        "Online application form for the Mannagetta Fellowship Program",
        "Detailed description of the dissertation project of 10 to 15 pages, including theoretical foundations and research question(s), previous preliminary work, and a detailed time and work plan for the requested funding period",
        "Application documents submitted through the OeAW online application form"
      ],
      "requirements": [
        "The programme statutes of the Mannagetta Fellowships and the guidelines for good scientific practice must be observed",
        "Signing the online application form confirms that the applicant wrote the project proposal independently",
        "Exceptions to the three-year rule are possible on proof of care responsibilities, illness or disability, but must be clarified with the OeAW Department of Fellowships and Awards before the application is submitted",
        "Other funding applications may be made, but they and their outcome must be reported in writing to the Department of Fellowships and Awards"
      ],
      "application_method": [
        "Online application via the OeAW online application form for the Mannagetta Fellowship Program"
