    {
      "name": "Scholarships of the Government of the Czech Republic for Students from Developing Countries",
      "legacy_titles": [
        "Czech Government Scholarships — Developing Countries (AY 2026/27)"
      ],
      "country": "Czech Republic",
      "degree_levels": "Master's, PhD",
      "funding_type": "Full Study Funding",
      "official_source": "Ministry of Education, Youth and Sports (MŠMT) / Dům zahraniční spolupráce (DZS)",
      "official_source_url": "https://msmt.gov.cz/eu-and-international-affairs/government-scholarships-developing-countries",
      "status": "upcoming",
      "is_verified": true,
      "last_verified_date": "2026-10-04",
      "region": "Europe",
      "description": "Scholarships of the Government of the Czech Republic for students from developing countries let nationals of designated partner states study at Czech public universities within the Czech foreign development cooperation programme. DZS states that \"the Czech Republic offers scholarships to foreigners for a standard period of study in accredited university study programmes provided at public universities, and for courses in the Czech language and vocational preparation\". Awards cover a master's study programme in Czech preceded by a one-year Czech language and professional training course, or study in master's and doctoral study programmes conducted in English. Applications are made through an electronic form, then the file passes through the applicant's Czech embassy, the Ministry of Foreign Affairs and MŠMT.",
      "deadline": "Official wording from DZS: \"Each candidate is required to submit an electronic application form no later than 30 September.\" For the 2027/2028 academic year applications opened on 21 August 2026 and the electronic-form deadline was 30 September 2026, which has already passed as of 2026-10-04.",
      "deadline_date": null,
      "deadline_precision": "recurring",
      "application_period": "Annual call. 2027/2028 cycle: applications open from 21 August 2026, electronic application form due 30 September 2026, supporting documents due 15 January 2027. Applications for the following annual cycle had not been announced on the official pages read.",
      "eligibility_summary": "Open to foreigners without permanent residence in the Czech Republic who are nationals of one of the states that receive Czech foreign development aid and who meet the conditions in the Guidelines for Granting Scholarships of the Government of the Czech Republic. Czech citizens, EU citizens and other foreign nationals holding a permanent residence permit in the Czech Republic may not apply, and there is no legal entitlement to the award.",
      "eligibility": [
        "Be a national of one of the states listed in the current annual call",
        "Not hold permanent residence in the Czech Republic",
        "Not be a citizen of the Czech Republic or of the European Union",
        "Meet the conditions set out in the Guidelines for Granting Scholarships of the Government of the Czech Republic",
        "For English-language study: advanced knowledge of English plus a pass in the online entrance English test",
        "For Czech-language study: Czech language command at least at CEFR B2 level (exempts the applicant from the one-year preparatory course)"
      ],
      "coverage": [
        "Standard period of study in an accredited study programme at a Czech public university",
        "One-year Czech language and professional training course where the Czech-language master's route requires it"
      ],
      "required_documents": [
        "Passport",
        "Documents of any started, passed and unfinished studies",
        "List of study or research stays abroad for the last 5 years (year, length, place, purpose)",
