        },
        "applicant_utility": {
          "application_readiness_checklist": [
            "Confirm you are enrolled in a first-cycle, second-cycle or long-cycle master's programme and that you are inside the 12-semester eligibility window (max 9 semesters first-cycle, 7 semesters second-cycle)",
            "Check you do not already hold a master's degree, or a bachelor's degree while re-enrolling in first-cycle studies - including degrees obtained abroad",
