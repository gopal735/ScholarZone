    {
      "name": "France Excellence Europa Scholarship Programme",
      "legacy_titles": [
        "France Excellence Europa Scholarship"
      ],
      "country": "France",
      "region": "Europe",
      "degree_levels": "Master's",
      "funding_type": "Stipend",
      "official_source": "Campus France / Ministry for Europe and Foreign Affairs (France)",
      "official_source_url": "https://www.campusfrance.org/en/france-excellence-europa-scholarship-program",
      "status": "upcoming",
      "is_verified": true,
      "last_verified_date": "2026-10-04",
      "deadline": "\"The deadline for submitting applications is 30 April 2025.\" That is the most recent closing date published on the official programme page (page updated 07 March 2025); no 2026 or 2027 call date was published on the pages read.",
      "deadline_date": null,
      "deadline_precision": "recurring",
      "application_period": "Annual cycle. The most recently published campaign closed on 30 April 2025, with embassy pre-selection from 2 to 13 May 2025, selection committees from 14 to 23 May 2025, results notified from 26 May 2025 and the final list completed in July 2025.",
      "application_method": [
        "Be admitted to, or hold an admission letter for, a Master 1 or Master 2 programme at a French higher education institution",
        "Complete the France Excellence Europa application form",
        "Assemble the required documents (CV, cover letter, diplomas and transcripts, identity document, admission letter or sworn statements)",
        "Send the application electronically to the French Embassy in your country of nationality, using the fee.<country>@campusfrance.org address listed for that country",
        "Wait for embassy pre-selection and Ministry selection committee assessment"
      ],
      "eligibility_summary": "Open to nationals of 26 EU Member States who want to study at Master's level in France. Applicants must be at least 18 at the start of the mobility, must not already hold a master's degree from any country, must be admitted to a Master 1 or Master 2 programme at a French institution, must not hold a French higher education degree or be currently registered in France for a higher education degree, and must not be receiving an Erasmus+, AUF or other French ministry scholarship. Students of French nationality, including bi-nationals, are not eligible.",
      "eligibility": [
        "National of one of the 26 eligible EU Member States: Germany, Austria, Belgium, Bulgaria, Cyprus, Croatia, Denmark, Spain, Estonia, Finland, Greece, Hungary, Ireland, Italy, Latvia, Lithuania, Luxembourg, Malta, Netherlands, Poland, Portugal, Czech Republic, Romania, Slovakia, Slovenia or Sweden",
        "Not a French national, including bi-nationals",
        "At least 18 years old when the mobility period in France begins",
        "Does not already possess a master's degree from any country (there is no upper age limit subject to this condition)",
        "Admitted to a French higher education institution in Master 1 or Master 2",
        "Not the holder of a French higher education degree and not currently registered in France for a higher education degree",
        "Not the recipient of an Erasmus+, AUF or other French ministry scholarship"
      ],
      "coverage": [
        "Half-yearly maintenance allowance of EUR 6,850",
        "One-off installation allowance of EUR 1,700",
        "Exemption from administrative registration fees for a national degree in public institutions under the Ministry of Higher Education",
        "Exemption from the CVEC (Contribution de Vie Etudiante et de Campus)",
        "Social protection contract for the first three months in France for holders without a European Health Insurance Card",
        "Complementary health insurance (mutual) arranged by Campus France",
        "Priority assistance in finding CROUS university residence accommodation, with rent paid by the scholarship holder",
        "Discounted cultural activities organised by Campus France"
      ],
      "required_documents": [
        "France Excellence Europa application form, duly completed and signed",
        "CV in French or English",
        "Cover letter in French or English",
        "Copy of the most recent higher education diploma, or of the secondary school diploma if still in higher education, translated into French or English",
        "Copies of transcripts from the last two years of higher education, translated into French or English",
        "Copy of an identity document (passport or ID card)",
        "Letter of admission to a Master 1 or Master 2 programme at a French institution",
        "Sworn statement for each choice of course if the admission letter is not yet held, together with evidence that the admission application is being processed"
      ],
      "english_requirement": null,
      "catalogue_url": "https://www.campusfrance.org/en/finding-a-university-programme-France",
      "official_updates_url": "https://www.campusfrance.org/en/actu/france-excellence-europa-scholarship-applications",
      "duration": "A maximum of 12 months when enrolling in Master 2 and a maximum of 24 months when enrolling in Master 1. The stay must begin between 1 September and 31 December of the year the scholarship is awarded, and no deferral is possible.",
      "funding_amount": 6850,
      "funding_currency": "EUR",
      "funding_period": "per half-year (semi-annual)",
      "program_type": "Government scholarship of the French Ministry for Europe and Foreign Affairs, managed by Campus France",
      "best_fit": "EU nationals (excluding French nationals) admitted to a French Master 1 or Master 2 programme in one of the seven eligible fields.",
      "notes": "Eligible fields of study are Culture and Heritage; Education and Pedagogy; French Language and Civilization, Foreign Languages and Civilizations and European Studies; Law and political sciences; Health; Environmental Sciences; and Computer Science and Digital. The scholarship is awarded on academic excellence and in line with the strategic priorities of the Ministry for Europe and Foreign Affairs. Applications are pre-selected by the college relations teams at the French embassies and then assessed within the Ministry by collaboration specialists from the eligible fields. The scholarship is maintained only for periods spent in France, except in specified internship or exchange cases, and signing an apprenticeship or professional contract automatically terminates it.",
      "description": "The France Excellence Europa scholarship programme, developed by the Ministry for Europe and Foreign Affairs and managed by Campus France, lets students from 26 EU Member States study at Master's level at a French higher education institution. It pays a semi-annual maintenance allowance of EUR 6,850 and a one-off installation allowance of EUR 1,700, exempts holders from administrative registration fees for a national degree in public institutions and from the CVEC, and arranges social protection and complementary health insurance. The award lasts up to 12 months for a Master 2 enrolment and up to 24 months for a Master 1 enrolment, and applications are sent electronically to the French Embassy in the applicant's country of nationality.",
      "detail": {
        "official_details": {
          "official_source_urls": [
            "https://www.campusfrance.org/en/france-excellence-europa-scholarship-program",
            "https://www.campusfrance.org/en/rights-and-obligations-of-the-france-excellence-europa-scholarship-holder"
          ],
          "application_link": "https://www.campusfrance.org/en/france-excellence-europa-scholarship-program",
          "official_updates_url": "https://www.campusfrance.org/en/actu/france-excellence-europa-scholarship-applications",
          "catalogue_url": "https://www.campusfrance.org/en/finding-a-university-programme-France",
          "application_cycle": "Annual; most recently published deadline 30 April 2025, with results notified from 26 May 2025 and the final list completed in July 2025",
          "deadline_central": null,
          "deadline_central_display": "The deadline for submitting applications is 30 April 2025 (most recent published campaign)",
          "deadline_central_timezone": "Europe/Paris",
          "deadline_note": "The official programme page (updated 07 March 2025) still publishes 'The deadline for submitting applications is 30 April 2025', which is in the past. No 2026 or 2027 closing date was published on the pages read, and the memorandum for scholarship holders was updated as recently as 12 August 2026, which confirms the programme continues to run. deadline_date is therefore null and the cycle is treated as recurring; applicants must check the Campus France call page for the current year's date.",
          "status": "UPCOMING",
          "status_note": "The most recently published campaign closed on 30 April 2025, so no applications can be submitted now. The programme itself is still active, since Campus France updated the scholarship-holder memorandum on 12 August 2026, so the next annual call is expected but its date is not yet published on the pages read.",
          "funding_amount": 6850,
          "funding_currency": "EUR",
          "funding_period": "per half-year (semi-annual)",
          "funding_duration": "Up to 12 months for a Master 2 enrolment and up to 24 months for a Master 1 enrolment",
          "tuition_coverage": false,
          "tuition_coverage_note": "Mixed and narrower than it looks. The memorandum states: 'For students enrolled in public institutions under the Ministry for Higher Education, please recall that the status of French government scholarship recipients exempts them from the payment of administrative registration fees for a national degree. In other situations, course fees are not covered by the France Excellence Europa program.' The programme page likewise states 'The \"France Excellence Europa\" scholarship does not cover course fees'. So only the administrative registration fee for a national degree at a public institution is exempted; course fees themselves are not covered.",
          "living_cost_coverage": true,
          "travel_coverage": false,
          "fully_funded": false,
          "funding_label": "Partially funded: semi-annual allowance of EUR 6,850 plus a one-off EUR 1,700 installation allowance, CVEC exemption and health cover; course fees are not covered and CROUS rent remains the holder's responsibility",
          "benefits": [
            "Half-yearly allowance of EUR 6,850 paid by bank transfer to a French account",
            "Installation allowance of EUR 1,700 collected in cash from a Western Union counter on arrival in France",
            "Exemption from administrative registration fees for a national degree in public institutions under the Ministry of Higher Education",
            "Exemption from the CVEC (Contribution de Vie Etudiante et de Campus)",
            "Social protection contract for the first three months for holders without a European Health Insurance Card",
            "Complementary health insurance (mutual) arranged by Campus France",
            "Access to CROUS university residence halls, with priority assistance in finding a place; rent is the holder's responsibility",
            "Weekend outings, short stays of 3 to 4 days, sporting activities and shows at discounted rates",
            "Access to the France Alumni network"
          ],
          "eligibility": [
            "National of one of 26 EU Member States: Germany, Austria, Belgium, Bulgaria, Cyprus, Croatia, Denmark, Spain, Estonia, Finland, Greece, Hungary, Ireland, Italy, Latvia, Lithuania, Luxembourg, Malta, Netherlands, Poland, Portugal, Czech Republic, Romania, Slovakia, Slovenia, Sweden",
            "Students of French nationality, including bi-nationals, are not eligible",
            "At least 18 years old when the mobility period in France begins",
            "No upper age limit, provided the applicant does not already possess a master's degree from any country",
            "Admitted to a French higher education institution in Master 1 or Master 2",
            "Not the holder of a French higher education degree and not currently registered in France for a higher education degree",
            "Not the recipient of an Erasmus+, AUF or other French ministry scholarship",
            "Study must fall within one of the eligible fields: Culture and Heritage; Education and Pedagogy; French Language and Civilization, Foreign Languages and Civilizations and European Studies; Law and political sciences; Health; Environmental Sciences; Computer Science and Digital"
          ],
          "citizenship_residency": "Restricted to nationals of 26 EU Member States. French nationals, including bi-nationals, are explicitly excluded.",
          "international_eligibility": "Open to EU nationals (other than French) admitted to a French Master's programme. Citizens of countries outside the EU are not eligible for this programme; Campus France directs them to other schemes such as France Excellence Eiffel.",
          "degree_levels": [
            "Master 1 (first year of a Master's)",
            "Master 2 (second year of a Master's)"
          ],
          "study_mode": "Full-time study at a French higher education institution, physically in France",
          "research_requirement": null,
          "subject_or_agency_requirement": "The programme of study must fall within one of the seven eligible fields: Culture and Heritage; Education and Pedagogy; French Language and Civilization, Foreign Languages and Civilizations and European Studies; Law and political sciences; Health; Environmental Sciences; Computer Science and Digital.",
          "application_method": "Complete the official application form and required documents, then send the application electronically to the French Embassy in the applicant's country of nationality, using the dedicated fee.<country>@campusfrance.org address published for that country. Where the applicant does not yet hold an admission letter, a sworn statement must be attached for each choice of course together with evidence that the admission application is being processed; the admission letter must be sent as soon as it is received.",
          "application_route": "By email to the French Embassy in the applicant's country of nationality; applications are pre-selected by the college relations teams at the embassies and then assessed within the Ministry for Europe and Foreign Affairs.",
          "requirements": [
            "Hold EU nationality other than French",
            "Be at least 18 at the start of the mobility in France",
            "Not already hold a master's degree from any country",
            "Be admitted to a Master 1 or Master 2 programme at a French institution",
            "Not hold a French higher education degree or be currently registered in France",
            "Not be receiving an Erasmus+, AUF or other French ministry scholarship",
            "Study within one of the seven eligible fields",
            "Send the complete file to the French Embassy before the published deadline",
            "After award: begin the stay in France between 1 September and 31 December of the year the scholarship is awarded"
          ],
          "documents": [
            "France Excellence Europa application form, duly completed and signed",
            "CV in French or English",
            "Cover letter in French or English",
            "Copy of the most recent higher education diploma, or of the secondary school diploma if the applicant is still in higher education, translated into French or English",
            "Copies of transcripts from the last two years of higher education, translated into French or English",
            "Copy of an identity document (passport or ID card)",
            "Letter of admission to a Master 1 or Master 2 programme at a French institution",
            "Sworn statement for each choice of course if the admission letter is not yet available",
            "Optional: copies of French certificates (DELF, DALF, TCF, TEF), English certificates (TOEFL, TOEIC, IELTS), letters of recommendation"
          ],
          "english_requirement": null,
          "english_requirement_note": "No English test score is required. The application may be prepared in French or English, and French or English certificates (DELF, DALF, TCF, TEF, TOEFL, TOEIC, IELTS) are listed only as optional supporting documents.",
          "selection_criteria": [
            "Academic excellence",
            "Alignment with the strategic priorities of the Ministry for Europe and Foreign Affairs",
            "Fit with one of the seven eligible fields, assessed by Ministry collaboration specialists",
            "Pre-selection by the college relations teams at the French embassies"
          ],
          "selection_weighting": "The programme states the scholarship is awarded 'on the basis of academic excellence and is in line with the strategic priorities of the Ministry for Europe and Foreign Affairs', without publishing a weighting.",
          "duration": "A maximum of 12 months when enrolling in Master 2 and a maximum of 24 months when enrolling in Master 1. The stay must begin between 1 September and 31 December of the year the scholarship is awarded, and the scholarship is granted for a defined number of months matching the accepted programme.",
          "award_holder_conditions": [
            "No deferral of the scholarship is possible",
            "The stay must begin between 1 September and 31 December of the year the scholarship is awarded",
            "The stay is financed only for periods taking place in France, except in specified internship or exchange cases",
            "The student must meet the academic requirements for each year of the programme to continue receiving the scholarship",
            "A caesura (gap year) terminates the scholarship, with only one gap year possible and a request needed at least two months in advance",
            "Signing an apprenticeship or professional contract automatically terminates the scholarship and all benefits",
            "Recipients must send Campus France a certificate of enrolment for the current year at the start of instruction",
            "Recipients must provide proof of successful training: school certificates in September-October, first semester evaluations at end of January-beginning of February, and final results at end of May",
            "Recipients must inform Campus France before starting an internship or going abroad, submitting the internship agreement at least one week in advance",
            "Rent of CROUS accommodation is the scholarship holder's responsibility",
            "The Ministry for Europe and Foreign Affairs reserves the right to stop payment if the holder's actions are incompatible with the programme's goals"
          ],
          "supplements_or_initiatives": [
            "Campus France social protection contract for the first three months for non-EHIC holders",
            "Complementary health insurance (mutual) arranged by Campus France",
            "Access to CROUS university residence halls with priority assistance",
            "Discounted cultural activities: weekend outings, short stays of 3 to 4 days, sporting activities and shows",
            "Registration for French social security at etudiant-etranger.ameli.fr",
            "France Alumni network"
          ],
          "official_contacts": {
            "general": "https://www.campusfrance.org/en/contact",
            "email": "boursiers.europe@campusfrance.org",
            "culture_email": "culture@campusfrance.org"
          },
          "description": "The France Excellence Europa scholarship programme, developed by the Ministry for Europe and Foreign Affairs and managed by Campus France, funds Master 1 and Master 2 study in France for nationals of 26 EU Member States. Holders receive a semi-annual allowance of EUR 6,850 and an installation allowance of EUR 1,700, are exempted from administrative registration fees for a national degree in public institutions and from the CVEC, and receive social protection cover and complementary health insurance arranged by Campus France. The award runs for up to 12 months at Master 2 and up to 24 months at Master 1, the stay must begin between 1 September and 31 December of the year of award, and applications go to the French Embassy in the applicant's country of nationality.",
          "program_type": "Government scholarship of the French Ministry for Europe and Foreign Affairs, managed by Campus France",
          "region": "Europe",
          "coverage": "Semi-annual maintenance allowance of EUR 6,850 plus a one-off installation allowance of EUR 1,700, CVEC exemption, social protection and complementary health insurance, and priority access to CROUS housing with rent payable by the holder. Course fees are not covered, and there is no travel or airfare component.",
          "last_verified_date": "2026-10-04"
        },
        "applicant_utility": {
          "application_readiness_checklist": [
            "Confirm you hold the nationality of one of the 26 eligible EU Member States and are not French, including as a bi-national",
            "Confirm you are at least 18 at the start of the mobility and do not already hold a master's degree",
            "Secure admission to a Master 1 or Master 2 programme at a French institution in one of the seven eligible fields",
            "Confirm you do not hold a French higher education degree and are not registered in France for a degree",
            "Confirm you are not receiving an Erasmus+, AUF or other French ministry scholarship",
            "Prepare the form, CV, cover letter, diploma and transcripts translated into French or English, and an identity document copy",
            "If you do not yet have an admission letter, prepare a sworn statement for each course choice plus evidence that the admission file is being processed",
            "Send the file to the fee.<country>@campusfrance.org address for your country of nationality before the published deadline",
            "If awarded, plan to arrive in France between 1 September and 31 December of the year of award, and open a French bank account for the semi-annual payments"
          ],
          "common_rejection_risks": [
            "Holding French nationality, including as a bi-national, which is an absolute bar",
            "Holding the nationality of an EU country not on the 26-country list, or of a non-EU country",
            "Already holding a master's degree from any country",
