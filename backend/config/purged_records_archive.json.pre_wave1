          },
          "description": "Bilateral state scholarships are based on scientific and educational cooperation agreements signed by the governments of two countries, with the Hungarian side offering scholarships for foreign students, researchers and lecturers. Applications are made either through a nomination by the applicant's national scholarship office or as an individual application in Tempus Public Foundation's online system, and are assessed by a formal eligibility check followed by external expert scoring. The programme covers four scholarship types: partial studies, full degree studies, study visits and summer courses.",
          "program_type": "Government-to-government bilateral state scholarship administered by the Tempus Public Foundation",
          "region": "Hungary",
          "coverage": "Covers courses free of charge plus a stipend, which may be topped up by a supplement or an accommodation contribution depending on the scholarship type; exact amounts are set in each Call for application. Travel is not mentioned on the pages read.",
          "last_verified_date": "2026-10-01"
        },
        "applicant_utility": {
          "application_readiness_checklist": [
            "Confirm your nationality is among the bilateral partner relations listed in the relevant call",
            "Decide whether to apply through your national scholarship office (nominated) or as an individual applicant",
            "Identify the right scholarship type for your intended stay: partial studies, full degree, study visit or summer course",
            "Check the deadline for your type: 19 February for partial, full degree and study visits; 27 February 5 pm CET for summer courses",
            "Use scholarship.hu for the first three calls and apply.diasporascholarship.hu for summer courses",
            "Start with the templates supplied: acceptance letter, workplan and motivation letter",
            "Contact the bilateral state scholarship officer for your country if the call conditions are unclear"
          ],
          "common_rejection_risks": [
            "Applying to a call reserved for a different partner relation",
            "Using the summer course portal for a non-summer-course call, or vice versa",
            "Missing the separate and earlier summer-course deadline of 27 February at 5 pm CET",
            "Assuming the stipend is identical across scholarship types; amounts and paying body vary",
            "Expecting a single consolidated stipend where the actual award is a supplement or accommodation contribution",
            "Applying through the national office without also submitting in the Tempus Public Foundation online system"
          ],
          "estimated_uncovered_costs": [
