          "official_contacts": {
            "general": "Tel: 021-5761263; Email: eduindonesia@163.com (published in the notice). Embassy of the People's Republic of China in the Republic of Indonesia, Jl. Mega Kuningan No.2, Jakarta Selatan, Indonesia"
          },
          "description": "The Embassy of the People's Republic of China in Indonesia opened the 2026/2027 Chinese Government Scholarship for applications, run as the China - Indonesia Scholarship in Higher Education Program with 20 places for undergraduate, master's and doctoral study, described as a full scholarship that does not include international travel expenses. The programme recruits students who go to China to study marine, medical, health, tourism, education and other required majors. Applicants submit everything online at www.campuschina.org under Indonesian Agency Number 3602 by 8 February 2026, after obtaining at least one pre-admission document from a target university, with the embassy recommending applications to the China Scholarship Council between 9 February and 5 March 2026. Bachelor's applicants must also sit the CSCA, and Chinese-taught master's and doctoral applicants must hold HSK Level 4.",
          "program_type": "Bilateral government scholarship dispatched by a Chinese embassy (national scholarship channel, Type not stated)",
          "region": "China (dispatched from Indonesia)",
          "coverage": "Described as a full scholarship covering tuition and living costs for study in China, but explicitly excluding international travel expenses, which the applicant must meet.",
          "last_verified_date": "2026-10-01"
        },
        "applicant_utility": {
          "application_readiness_checklist": [
            "Confirm you are a non-Chinese citizen in good health and inside the age cap: under 25 undergraduate, under 35 master's, under 40 doctoral, under 45 general scholar, under 50 senior scholar",
            "Contact target Chinese universities and secure at least one pre-admission document before the application deadline, since this gates the whole application",
            "For bachelor's study, register for and take the CSCA on December 21, 2025, or January 25, 2026 if you intend to enrol in September 2026, and keep the score report",
            "For Chinese-taught master's or doctoral study, obtain an HSK Level 4 certificate; general and senior scholar programmes need HSK Level 3",
            "Passport must have at least 12 months validity from the expected start date of study, or be renewed first",
            "Get all non-Chinese or non-English documents notarised in Chinese or English",
            "Secure two professor or associate professor recommendation letters if applying to a graduate or senior scholar programme",
            "Have a physical examination form ready if you will stay in China more than 6 months, since the result is valid for only 6 months",
            "Obtain a non-criminal record report issued within 6 months of submission",
            "Use Indonesian Agency Number 3602 in the campuschina.org application"
          ],
          "common_rejection_risks": [
            "Missing the pre-admission document, which is mandatory for all applicants",
            "Missing the CSCA or holding an expired score report for a bachelor's application",
            "HSK level below the required level for the language of instruction",
            "Passport with less than 12 months validity from the expected start date",
            "Untranslated or non-notarised documents",
            "Holding another Chinese government or admitted-university scholarship, which cancels the award and requires repayment",
            "Applying through the embassy with paper materials, which the notice says is unnecessary and not accepted"
          ],
          "estimated_uncovered_costs": [
            "International travel expenses, explicitly excluded by the notice",
            "Costs outside the scope of the full scholarship, which the notice does not itemise",
            "Any funding needed for a second Chinese government or university scholarship, which is prohibited"
          ],
          "document_audit": [
            "Verify the passport scan shows the information page clearly and the validity period runs at least 12 months past the expected start of study",
            "Check the Foreigner Physical Examination Form includes every listed item, the attending physician's signature, the official hospital stamp, and a sealed photograph, since omissions invalidate it",
            "Confirm the study plan or research proposal word count: 200 words undergraduate, 500 non-degree, 800 postgraduate",
            "Confirm the non-criminal record was issued within 6 months of the submission date",
            "Re-check that all scanned uploads are clear, authentic and valid, as unclear or unidentifiable materials leave the applicant bearing the consequences"
          ],
          "alerts": [
            {
              "trigger": "You intend to enrol in September 2026 and are applying for a bachelor's degree",
              "message": "You must register for and take the CSCA on December 21, 2025, or January 25, 2026 - there are only those two sittings for this intake."
            },
            {
              "trigger": "You are offered another scholarship from a Chinese government body or your admitted university",
              "message": "Holding both cancels the Chinese Government Scholarship and requires the money to be returned; deliberate concealment also bars you from Chinese Government Scholarships for three years."
            },
            {
              "trigger": "Your passport expires within 12 months of the expected start of study",
              "message": "The notice requires renewal before applying, so renew first rather than applying and risking ineligibility."
            }
          ],
          "submission_workflow": [
            "Check nationality, health, age cap and language-of-instruction requirements",
            "Research Chinese universities on www.campuschina.org and contact preferred institutions",
            "Obtain at least one pre-admission document from a chosen university",
            "For bachelor's study, register for and sit the CSCA on the prescribed date and obtain the score report",
            "Prepare notarised translations of all non-Chinese or non-English documents, plus HSK or IELTS/TOEFL certificates as applicable",
            "Obtain the physical examination form and non-criminal record within their validity windows",
            "Submit the complete online application at www.campuschina.org with Indonesian Agency Number 3602 before 8 February 2026",
            "After the embassy forwards recommendations (9 February - 5 March 2026), check results in the system from July to August 2026 and download the admission notice and JW201 form"
          ]
