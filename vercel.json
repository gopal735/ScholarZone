{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "backend": {
      "root": "backend",
      "framework": "fastapi",
      "entrypoint": "api.index:app",
      "buildCommand": "python scripts/embed_build_revision.py",
      "installCommand": "pip install -r requirements.txt && python scripts/embed_build_revision.py",
      "routes": [
        {
          "src": "/api/(.*)",
          "transforms": [
            {
              "type": "request.path",
              "op": "set",
              "args": "/$1"
            }
          ]
        }
      ]
    },
    "frontend": {
      "root": "frontend",
      "framework": "vite",
      "rewrites": [
        {
          "source": "/((?!api/|assets/|scholarships-snapshot\\.json|favicon\\.svg|icons\\.svg|robots\\.txt|sitemap\\.xml|404\\.html).*)",
          "destination": "/index.html"
        }
      ]
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": {
        "service": "backend"
      }
    },
    {
      "source": "/(.*)",
      "destination": {
        "service": "frontend"
      }
    }
  ],
  "crons": [
    {
      "path": "/api/internal/maintenance/dispatch",
      "schedule": "0 9 * * *"
    }
  ]
}
